    /**
     * Manages interactive Zorkdex browsing (listing all, searching by name/ID, filtering by type).
     */
    private static void openZorkdex(Scanner scanner) {
        boolean inZorkdex = true;
        while (inZorkdex) {
            System.out.println("\n--- ZORKDEX ---");
            System.out.println("1. Display All Zorkdex Entries");
            System.out.println("2. Search Zorkdex by Name");
            System.out.println("3. Search Zorkdex by Number");
            System.out.println("4. Filter Zorkdex by Type");
            System.out.println("5. Return to Main Menu");
            System.out.print("Choose an option > ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1":
                    System.out.println("\n--- All Zorkdex Entries (#000 - #155) ---");
                    for (ZorkdexEntry zorkdexEntry : ZorkdexEntry.getAllEntries()) {
                        System.out.println(zorkdexEntry);
                    }
                    break;
                case "2":
                    System.out.print("Enter name to search in Zorkdex: ");
                    String zorkdexSearchName = scanner.nextLine().trim();
                    List<ZorkdexEntry> zorkdexNameMatches = ZorkdexEntry.getAllEntries().stream()
                            .filter(p -> p.getName().equalsIgnoreCase(zorkdexSearchName))
                            .collect(Collectors.toList());
                    if (zorkdexNameMatches.isEmpty()) {
                        System.out.println("No Zorkdex entry found matching: " + zorkdexSearchName);
                    } else {
                        zorkdexNameMatches.forEach(System.out::println);
                    }
                    break;
                case "3":
                    System.out.print("Enter Zorkdex number (000-155): ");
                    try {
                        int zorkdexNum = Integer.parseInt(scanner.nextLine().trim());
                        ZorkdexEntry.getAllEntries().stream()
                                .filter(p -> p.getId() == zorkdexNum)
                                .findFirst()
                                .ifPresentOrElse(
                                        System.out::println,
                                        () -> System.out.println("No Zorkdex entry with #" + String.format("%03d", zorkdexNum))
                                );
                    } catch (NumberFormatException e) {
                        System.out.println("Invalid number format!");
                    }
                    break;
                case "4":
                    System.out.print("Enter type (e.g. Fire, Dragon, Bug): ");
                    String zorkdexType = scanner.nextLine().trim();
                    List<ZorkdexEntry> zorkdexTypeMatches = ZorkdexEntry.getAllEntries().stream()
                            .filter(p -> p.getPrimaryType().equalsIgnoreCase(zorkdexType) ||
                                         (p.getSecondaryType() != null && p.getSecondaryType().equalsIgnoreCase(zorkdexType)))
                            .collect(Collectors.toList());
                    if (zorkdexTypeMatches.isEmpty()) {
                        System.out.println("No Zorkdex entries found with type: " + zorkdexType);
                    } else {
                        System.out.printf("\n--- %s Type Zorkdex Entries (%d found) ---\n", zorkdexType, zorkdexTypeMatches.size());
                        zorkdexTypeMatches.forEach(System.out::println);
                    }
                    break;
                case "5":
                    inZorkdex = false;
                    System.out.println("Closing Zorkdex...\n");
                    break;
                default:
                    System.out.println("Invalid choice! Please pick 1-5.");
                    break;
            }
        }
    }

