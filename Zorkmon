    private static void triggerWildEncounter(String room, ZorkmonPet player, Scanner scanner, Random random) {
        if ((room.equals("Route 1") || room.equals("Pinwheel Forest")) && random.nextInt(6) == 0) {
            ZorkmonPet wild;
            if (room.equals("Route 1")) {
                ZorkmonPet[] pool = {
                    new ZorkmonPet("Patrat", "Normal", null, 3, 45, 12, 10, 51, Move.TACKLE),
                    new ZorkmonPet("Lillipup", "Normal", null, 4, 50, 14, 11, 55, Move.BITE),
                    new ZorkmonPet("Pidove", "Normal", "Flying", 3, 48, 13, 10, 53, Move.GUST)
                };
                wild = pool[random.nextInt(pool.length)];
            } else {
                ZorkmonPet[] pool = {
                    new ZorkmonPet("Sewaddle", "Bug", "Grass", 4, 55, 15, 13, 62, Move.get("Bug Bite")),
                    new ZorkmonPet("Venipede", "Bug", "Poison", 4, 60, 16, 12, 52, Move.get("Poison Tail")),
                    new ZorkmonPet("Joltik", "Bug", "Electric", 5, 40, 18, 9, 64, Move.get("Electroweb"))
                };
                wild = pool[random.nextInt(pool.length)];
            }

            System.out.println("\n[!] A wild " + wild.name + " (" + wild.getTypeDisplay() + " Type) appeared!");
            startBattle(player, wild, scanner, random, null, null, null);
        }
    }

    private static boolean startBattle(ZorkmonPet player, ZorkmonPet opponent, Scanner scanner, Random random, String rivalName, String playerGender, String playerName) {
        System.out.println("================ BATTLE START ================");
        if (rivalName != null) {
            printRivalBattleStartDialogue(rivalName, playerGender, playerName, opponent.name);
        } else {
            System.out.println("Battle against wild " + opponent.name + " (" + opponent.getTypeDisplay() + " Type)!");
        }

        while (!player.isFainted() && !opponent.isFainted()) {
            System.out.println("\n" + player.name + " HP: " + player.hp + "/" + player.maxHp + " | " + opponent.name + " HP: " + opponent.hp + "/" + opponent.maxHp);
            System.out.println("Choose move: [1] Tackle  [2] " + player.specialMove.getName() + " (" + player.specialMove.getType() + ")  [3] Run");
            System.out.print("Battle > ");

            String choice = scanner.nextLine().trim();

            if (choice.equals("3") || choice.equalsIgnoreCase("run")) {
                System.out.println("You fled back to safety!");
                return false;
            }

            // Player Turn
            int playerDamage = 0;
            if (choice.equals("1") || choice.equalsIgnoreCase("tackle")) {
                playerDamage = calculateFormulaDamage(player, opponent, Move.TACKLE, random);
                System.out.println("\n" + player.name + " used Tackle!");
            } else if (choice.equals("2") || choice.equalsIgnoreCase(player.specialMove.getName())) {
                playerDamage = calculateFormulaDamage(player, opponent, player.specialMove, random);
                
                double typeMod = getFullTypeMultiplier(player.specialMove.getType(), opponent.primaryType, opponent.secondaryType);
                System.out.print("\n" + player.name + " used " + player.specialMove.getName() + "! ");
                if (typeMod > 1.0) {
                    System.out.println("It's super effective!");
                } else if (typeMod == 0.0) {
                    System.out.println("It had no effect!");
                } else if (typeMod < 1.0) {
                    System.out.println("It's not very effective...");
                } else {
                    System.out.println();
                }
            } else {
                System.out.println("Invalid choice! You stumbled and lost your turn!");
            }

            if (playerDamage > 0) {
                opponent.hp = Math.max(0, opponent.hp - playerDamage);
                System.out.println(opponent.name + " took " + playerDamage + " damage!");
            }

            if (opponent.isFainted()) {
                System.out.println("\n" + opponent.name + " fainted! You won the battle!");
                
                int expGained = (opponent.baseExpYield * opponent.level) / 7;
                player.gainExp(expGained);
                return true;
            }

            // Opponent Turn
            System.out.println("\n" + opponent.name + " attacks!");
            int oppDamage = calculateFormulaDamage(opponent, player, opponent.specialMove, random);
            
            double oppTypeMod = getFullTypeMultiplier(opponent.specialMove.getType(), player.primaryType, player.secondaryType);
            System.out.print(opponent.name + " used " + opponent.specialMove.getName() + "! ");
            if (oppTypeMod > 1.0) {
                System.out.println("It's super effective!");
            } else if (oppTypeMod == 0.0) {
                System.out.println("It had no effect!");
            } else if (oppTypeMod < 1.0) {
                System.out.println("It's not very effective...");
            } else {
                System.out.println();
            }

            player.hp = Math.max(0, player.hp - oppDamage);
            System.out.println(player.name + " took " + oppDamage + " damage!");
        }

        return false;
    }

