    private static int handleFieldSwitch(List<ZorkmonPet> party, int currentActiveIndex, Scanner scanner) {
        if (party.size() <= 1) {
            System.out.println("You only have 1 Zorkmon in your team! Catch more wild Zorkmon to switch.");
            return currentActiveIndex;
        }

        System.out.println("\n--- SELECT ZORKMON TO SWITCH TO ---");
        for (int i = 0; i < party.size(); i++) {
            ZorkmonPet pet = party.get(i);
            String statusStr = (i == currentActiveIndex) ? " [CURRENT ACTIVE]" : "";
            if (pet.isFainted()) statusStr += " (FAINTED)";
            System.out.println("[" + (i + 1) + "] " + pet.name + pet.getStatusTag() + " (Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + ")" + statusStr);
        }
        System.out.print("Select Zorkmon number (or 0 to cancel) > ");
        try {
            int sel = Integer.parseInt(scanner.nextLine().trim());
            if (sel > 0 && sel <= party.size()) {
                int targetIdx = sel - 1;
                if (targetIdx == currentActiveIndex) {
                    System.out.println(party.get(targetIdx).name + " is already active!");
                } else if (party.get(targetIdx).isFainted()) {
                    System.out.println(party.get(targetIdx).name + " is fainted and cannot battle!");
                } else {
                    System.out.println("Switched leading Zorkmon to " + party.get(targetIdx).name + "!");
                    return targetIdx;
                }
            }
        } catch (NumberFormatException e) {
            System.out.println("Invalid selection!");
        }
        return currentActiveIndex;
    }

    private static boolean promptPartyReplacement(List<ZorkmonPet> party, ZorkmonPet newPet, Scanner scanner) {
        System.out.println("Do you want to swap " + newPet.name + " into your party?");
        System.out.println("[1] Yes, replace a member in my party");
        System.out.println("[2] No, send " + newPet.name + " to storage");
        System.out.print("Select > ");

        String choice = scanner.nextLine().trim();
        if (choice.equals("1") || choice.equalsIgnoreCase("yes")) {
            System.out.println("\n--- SELECT ZORKMON TO REPLACE ---");
            for (int i = 0; i < party.size(); i++) {
                ZorkmonPet pet = party.get(i);
                System.out.println("[" + (i + 1) + "] " + pet.name + pet.getStatusTag() + " (Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + ")");
            }
            System.out.print("Select slot to replace (1-6) or 0 to cancel > ");
            try {
                int slot = Integer.parseInt(scanner.nextLine().trim());
                if (slot >= 1 && slot <= party.size()) {
                    ZorkmonPet oldPet = party.set(slot - 1, newPet);
                    System.out.println("Swapped out " + oldPet.name + " for " + newPet.name + "!");
                    return true;
