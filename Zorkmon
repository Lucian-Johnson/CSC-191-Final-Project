    /**
     * Interactive starter Zorkmon selection menu.
     */
    private static ZorkmonPet chooseStarter(Scanner scanner) {
        while (true) {
            System.out.println("\nChoose your Gen 5 starter Zorkmon:");
            System.out.println("[1] Snivy (Grass)");
            System.out.println("[2] Tepig (Fire)");
            System.out.println("[3] Oshawott (Water)");
            System.out.print("Selection > ");

            String choice = scanner.nextLine().trim();

            if (choice.equals("1") || choice.equalsIgnoreCase("snivy")) {
                return new ZorkmonPet("Snivy", "Grass", null, 5, 100, 20, 15, 62, 45, Move.VINE_WHIP);
            } else if (choice.equals("2") || choice.equalsIgnoreCase("tepig")) {
