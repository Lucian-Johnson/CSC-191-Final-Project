    /**
     * Executes a single Zorkmon's move turn: checks pre-turn status blocks (Flinch, Sleep, Freeze, Paralysis, Confusion),
     * rolls accuracy, calculates damage, thaws frozen targets on Fire moves, and rolls secondary effects.
     *
     * @param attacker             the Zorkmon using the move
     * @param defender             the opposing Zorkmon
     * @param move                 the Move being executed
     * @param defenderAlreadyActed true if the defender has already moved earlier in this round (prevents late-turn flinch)
     * @param random               Random generator
     * @param defenderPrefix       display prefix (e.g., "" or "Rival's ")
     */
    private static void executeMoveTurn(ZorkmonPet attacker, ZorkmonPet defender, Move move, boolean defenderAlreadyActed, Random random, String defenderPrefix) {
        if (!canActThisTurn(attacker, random)) {
            return;
        }

        System.out.print("\n" + attacker.name + " used " + move.getName() + "! ");

        // Accuracy check (accuracy == 0 denotes self-targeting or always-hit moves)
        if (move.getAccuracy() > 0 && random.nextInt(100) >= move.getAccuracy()) {
            System.out.println("\n" + attacker.name + "'s attack missed!");
            return;
        }

        // Status category moves deal no direct damage and immediately attempt their effect
        if ("Status".equalsIgnoreCase(move.getCategory())) {
            System.out.println();
            if (move.getEffect() != null) {
                applySecondaryEffect(attacker, defender, move, defenderAlreadyActed, random, true);
            } else {
                System.out.println("But nothing happened!");
            }
            return;
        }

        double typeMod = getFullTypeMultiplier(move.getType(), defender.primaryType, defender.secondaryType);
        if (typeMod > 1.0) {
            System.out.println("It's super effective!");
        } else if (typeMod == 0.0) {
            System.out.println("It had no effect!");
            return;
        } else if (typeMod < 1.0) {
            System.out.println("It's not very effective...");
        } else {
            System.out.println();
        }

        int damage = calculateFormulaDamage(attacker, defender, move, random);
        if (damage > 0) {
            defender.hp = Math.max(0, defender.hp - damage);
            System.out.println(defenderPrefix + defender.name + " took " + damage + " damage!");

            // Fire-type moves immediately thaw a frozen target
            if ("Fire".equalsIgnoreCase(move.getType()) && "FRZ".equals(defender.status) && !defender.isFainted()) {
                defender.status = "NONE";
                System.out.println(defenderPrefix + defender.name + " thawed out!");
            }
        }

        // Roll secondary effect if the target survived the hit
        if (!defender.isFainted() && move.getEffect() != null) {
            applySecondaryEffect(attacker, defender, move, defenderAlreadyActed, random, false);
        }
    }

    /**
     * Evaluates whether a Zorkmon is prevented from acting due to Flinch, Sleep, Freeze, Paralysis, or Confusion.
     */
    private static boolean canActThisTurn(ZorkmonPet pet, Random random) {
        if (pet.flinched) {
            pet.flinched = false;
            System.out.println("\n" + pet.name + " flinched and couldn't move!");
            return false;
        }

        if ("SLP".equals(pet.status)) {
            if (pet.sleepTurns > 0) {
                pet.sleepTurns--;
                System.out.println("\n" + pet.name + " is fast asleep.");
                return false;
            } else {
                pet.status = "NONE";
                System.out.println("\n" + pet.name + " woke up!");
            }
        }

        if ("FRZ".equals(pet.status)) {
            if (random.nextInt(100) < 20) {
                pet.status = "NONE";
                System.out.println("\n" + pet.name + " thawed out!");
            } else {
                System.out.println("\n" + pet.name + " is frozen solid!");
                return false;
            }
        }

        if ("PAR".equals(pet.status)) {
            if (random.nextInt(100) < 25) {
                System.out.println("\n" + pet.name + " is paralyzed! It can't move!");
                return false;
            }
        }

        if (pet.confusionTurns > 0) {
            pet.confusionTurns--;
            if (pet.confusionTurns == 0) {
                System.out.println("\n" + pet.name + " snapped out of its confusion!");
            } else {
                System.out.println("\n" + pet.name + " is confused!");
                if (random.nextInt(100) < 50) {
                    int selfDamage = Math.max(1, (((2 * pet.level / 5 + 2) * 40 * pet.attack) / pet.defense) / 50 + 2);
                    pet.hp = Math.max(0, pet.hp - selfDamage);
                    System.out.println("It hurt itself in its confusion for " + selfDamage + " damage!");
                    return false;
                }
            }
        }

        return true;
    }

    /**
     * Rolls and applies secondary status or volatile effects (Burn, Flinch, Paralysis, Poison, Freeze, Sleep, Confusion).
     */
    private static void applySecondaryEffect(ZorkmonPet attacker, ZorkmonPet defender, Move move, boolean defenderAlreadyActed, Random random, boolean isStatusMove) {
        if (random.nextInt(100) >= move.getEffectChance()) {
            return;
        }

        String effect = move.getEffect();
        if ("TRI_ATTACK".equals(effect)) {
            String[] triOptions = {"BURN", "PARALYZE", "FREEZE"};
            effect = triOptions[random.nextInt(triOptions.length)];
        }

        switch (effect) {
            case "FLINCH":
                // Flinch only works if the target has not yet acted this turn
                if (!defenderAlreadyActed) {
                    defender.flinched = true;
                }
                break;

            case "CONFUSE":
                if (defender.confusionTurns > 0) {
                    if (isStatusMove) System.out.println(defender.name + " is already confused!");
                } else {
                    defender.confusionTurns = 1 + random.nextInt(4); // 1 to 4 turns
                    System.out.println(defender.name + " became confused!");
                }
                break;

            case "BURN":
                if (defender.hasType("Fire")) {
                    if (isStatusMove) System.out.println("It doesn't affect " + defender.name + "...");
                } else if (!"NONE".equals(defender.status)) {
                    if (isStatusMove) System.out.println("But it failed! " + defender.name + " already has a status condition.");
                } else {
                    defender.status = "BRN";
                    System.out.println(defender.name + " was burned!");
                }
                break;

            case "PARALYZE":
                // Ground-type immunity applies to Electric-type status moves like Thunder Wave
                if ("Electric".equalsIgnoreCase(move.getType()) && defender.hasType("Ground")) {
                    if (isStatusMove) System.out.println("It doesn't affect " + defender.name + "...");
                } else if (!"NONE".equals(defender.status)) {
                    if (isStatusMove) System.out.println("But it failed! " + defender.name + " already has a status condition.");
                } else {
                    defender.status = "PAR";
                    System.out.println(defender.name + " is paralyzed! It may be unable to move!");
                }
                break;

            case "POISON":
                if (defender.hasType("Poison") || defender.hasType("Steel")) {
                    if (isStatusMove) System.out.println("It doesn't affect " + defender.name + "...");
                } else if (!"NONE".equals(defender.status)) {
                    if (isStatusMove) System.out.println("But it failed! " + defender.name + " already has a status condition.");
                } else {
                    defender.status = "PSN";
                    System.out.println(defender.name + " was poisoned!");
                }
                break;

            case "FREEZE":
                if (defender.hasType("Ice")) {
                    if (isStatusMove) System.out.println("It doesn't affect " + defender.name + "...");
                } else if (!"NONE".equals(defender.status)) {
                    if (isStatusMove) System.out.println("But it failed! " + defender.name + " already has a status condition.");
                } else {
                    defender.status = "FRZ";
                    System.out.println(defender.name + " was frozen solid!");
                }
                break;

            case "SLEEP":
                if (!"NONE".equals(defender.status)) {
                    if (isStatusMove) System.out.println("But it failed! " + defender.name + " already has a status condition.");
                } else {
                    defender.status = "SLP";
                    defender.sleepTurns = 1 + random.nextInt(3); // 1 to 3 turns
                    System.out.println(defender.name + " fell asleep!");
                }
                break;
        }
    }

    /**
     * Applies end-of-turn residual damage from Burn (1/8 Max HP) or Poison (1/8 Max HP).
     */
    private static void applyEndOfTurnStatusDamage(ZorkmonPet pet) {
        if ("BRN".equals(pet.status)) {
            int burnDamage = Math.max(1, pet.maxHp / 8);
            pet.hp = Math.max(0, pet.hp - burnDamage);
            System.out.println(pet.name + " was hurt by its burn for " + burnDamage + " damage!");
        } else if ("PSN".equals(pet.status)) {
            int poisonDamage = Math.max(1, pet.maxHp / 8);
            pet.hp = Math.max(0, pet.hp - poisonDamage);
            System.out.println(pet.name + " was hurt by poison for " + poisonDamage + " damage!");
        }
    }

    private static int handleInBattleSwitch(List<ZorkmonPet> party, int currentIdx, Scanner scanner) {
        if (party.size() <= 1) {
            System.out.println("You have no other Zorkmon in your party to switch to!");
            return currentIdx;
        }

        System.out.println("\n--- SWITCH ZORKMON ---");
        for (int i = 0; i < party.size(); i++) {
            ZorkmonPet pet = party.get(i);
            String statusStr = (i == currentIdx) ? " [IN BATTLE]" : "";
            if (pet.isFainted()) statusStr += " (FAINTED)";
            System.out.println("[" + (i + 1) + "] " + pet.name + pet.getStatusTag() + " (Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + ")" + statusStr);
        }
        System.out.print("Choose Zorkmon to send out (or 0 to cancel) > ");
        try {
            int sel = Integer.parseInt(scanner.nextLine().trim());
            if (sel > 0 && sel <= party.size()) {
                int targetIdx = sel - 1;
                if (targetIdx == currentIdx) {
                    System.out.println(party.get(targetIdx).name + " is already in battle!");
                } else if (party.get(targetIdx).isFainted()) {
                    System.out.println(party.get(targetIdx).name + " is fainted and cannot battle!");
                } else {
                    return targetIdx;
                }
            }
        } catch (NumberFormatException e) {
            System.out.println("Invalid selection!");
        }
        return currentIdx;
    }

    private static int forceBattleSwitch(List<ZorkmonPet> party, int currentIdx, Scanner scanner) {
        System.out.println("\n--- CHOOSE NEXT ZORKMON ---");
        for (int i = 0; i < party.size(); i++) {
