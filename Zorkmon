    /**
     * Executes the main gameplay loop: intro sequence, navigation, field interaction, and combat triggers.
     */
    private static void runGame(Scanner scanner, Random random) {
        System.out.println("\n------------------------------------------------------------------");
        System.out.println("                 STARTING ZORKMON ADVENTURE                       ");
        System.out.println("------------------------------------------------------------------");

        // --- PROFESSOR JUNIPER INTRO DIALOGUE ---
        System.out.println("Professor Juniper: \"Hello there! Welcome to the world of Zorkmon!\"");
        System.out.println("Professor Juniper: \"My name is Professor Juniper. People call me the Zorkmon Professor!\"");
        System.out.println("Professor Juniper: \"This world is inhabited by creatures known as Zorkmon, living alongside humans as friends and partners.\"");

        System.out.print("\nProfessor Juniper: \"First, tell me... what is your name?\" > ");
        String playerName = scanner.nextLine().trim();
        if (playerName.isEmpty()) {
            playerName = "Hero";
        }

        // Gender Selection Dialogue
        String playerGender = "";
        while (true) {
            System.out.println("\nProfessor Juniper: \"Are you a boy, a girl, or non-binary?\"");
            System.out.println("[1] Boy");
            System.out.println("[2] Girl");
            System.out.println("[3] Non-binary");
            System.out.print("Selection > ");

            String genderChoice = scanner.nextLine().trim();
            if (genderChoice.equals("1") || genderChoice.equalsIgnoreCase("boy")) {
                playerGender = "Boy";
                break;
            } else if (genderChoice.equals("2") || genderChoice.equalsIgnoreCase("girl")) {
                playerGender = "Girl";
                break;
            } else if (genderChoice.equals("3") || genderChoice.equalsIgnoreCase("non-binary") || genderChoice.equalsIgnoreCase("nonbinary")) {
                playerGender = "Non-binary";
                break;
            } else {
                System.out.println("Invalid selection! Please choose 1, 2, or 3.");
            }
        }

        System.out.print("\nProfessor Juniper: \"And what is the name of your rival?\" > ");
        String rivalName = scanner.nextLine().trim();
        if (rivalName.isEmpty()) {
            rivalName = "Cheren";
        }

        System.out.println("\nProfessor Juniper: \"Right! So your name is " + playerName + ", and your rival is " + rivalName + "!\"");
        System.out.println("Professor Juniper: \"Your very own Zorkmon legend is about to unfold!\"");

        // Starter Selection, Initial Party & PC Storage Setup
        ZorkmonPet starter = chooseStarter(scanner);
        List<ZorkmonPet> party = new ArrayList<>();
        party.add(starter);
        List<ZorkmonPet> storageBox = new ArrayList<>(); // PC Storage Box List

        // Determine Rival's Starter based on remaining choices
        List<ZorkmonPet> remainingStarters = new ArrayList<>();
        if (!starter.name.equals("Snivy")) {
            remainingStarters.add(new ZorkmonPet("Snivy", "Grass", null, 5, 100, 20, 15, 62, 45, Move.VINE_WHIP));
        }
        if (!starter.name.equals("Tepig")) {
            remainingStarters.add(new ZorkmonPet("Tepig", "Fire", null, 5, 85, 22, 12, 62, 45, Move.EMBER));
        }
        if (!starter.name.equals("Oshawott")) {
            remainingStarters.add(new ZorkmonPet("Oshawott", "Water", null, 5, 110, 18, 14, 62, 45, Move.WATER_GUN));
        }

        ZorkmonPet rivalStarter = remainingStarters.get(random.nextInt(remainingStarters.size()));

        // --- Build Rival's Party of 3 ---
        List<ZorkmonPet> rivalParty = new ArrayList<>();
        rivalParty.add(rivalStarter); // 1. Starter

        // 2. Zorkmon from Route 1
        ZorkmonPet[] route1Pool = {
            new ZorkmonPet("Patrat", "Normal", null, 4, 50, 13, 11, 51, 255, Move.TACKLE),
            new ZorkmonPet("Lillipup", "Normal", null, 4, 52, 15, 12, 55, 255, Move.BITE),
            new ZorkmonPet("Pidove", "Normal", "Flying", 4, 50, 14, 11, 53, 255, Move.GUST)
        };
        rivalParty.add(route1Pool[random.nextInt(route1Pool.length)]);

        // 3. Zorkmon from Pinwheel Forest
        ZorkmonPet[] forestPool = {
            new ZorkmonPet("Sewaddle", "Bug", "Grass", 5, 58, 16, 14, 62, 255, Move.get("Bug Bite")),
            new ZorkmonPet("Venipede", "Bug", "Poison", 5, 63, 17, 13, 52, 255, Move.get("Poison Tail")),
            new ZorkmonPet("Joltik", "Bug", "Electric", 5, 42, 19, 10, 64, 190, Move.get("Electroweb"))
        };
        rivalParty.add(forestPool[random.nextInt(forestPool.length)]);

        System.out.println("\nYou chose " + starter.name + "!");
        System.out.println(rivalName + " chose " + rivalStarter.name + "!");

        // Professor Juniper Gift & Economy Initialization
        int[] zorkBalls = {10};   // Pass-by-reference array wrapper for Zork Balls
        int[] potions = {1};       // Pass-by-reference array wrapper for Potions
        int[] rareCandies = {0};   // Pass-by-reference array wrapper for Rare Candies
        int[] money = {1000};      // Starts with $1000 starting cash

        System.out.println("\nProfessor Juniper: \"Before you head out on Route 1, take these! They will help you catch wild Zorkmon.\"");
        System.out.println(">>> Professor Juniper handed you 10 Zork Balls and $1000! <<<");
        System.out.println("Professor Juniper: \"Good luck, " + playerName + "! Go explore the Unova region!\"\n");

        String currentRoom = "Nuvema Town";
        boolean itemFound = false;
        boolean npcDefeated = false;
        int activeIndex = 0; // Tracks lead active Zorkmon index in party

        boolean running = true;
        while (running) {
            ZorkmonPet activePet = party.get(activeIndex);

            System.out.println("\n------------------------------------------------------------------");
            System.out.println("[ Location: " + currentRoom + " ]");
            System.out.println("Actions: [1] Look  [2] Map  [3] Go North  [4] Go South  [5] Go East");
            System.out.println("         [6] Go West  [7] Search  [8] Check Party/Status  [9] Switch");
            System.out.println("         [10] Center  [11] Mart  [12] Challenge  [13] Main Menu");
            System.out.println("         [14] Items  [15] Hunt (Wild Encounter)");
            System.out.print("> ");
            String input = scanner.nextLine().trim().toLowerCase();

            switch (input) {
                case "1":
                case "look":
                    describeRoom(currentRoom, rivalParty.get(0), itemFound, npcDefeated, rivalName);
                    if (currentRoom.equals("Relic Castle")) {
                        System.out.print("\nWhat is the greatest promise? > ");
                        String answer = scanner.nextLine().trim().toLowerCase();
                        if (answer.equals("tomorrow")) {
                            rareCandies[0] += 999;
                            System.out.println("\n✨ ======================================================= ✨");
                            System.out.println("   Correct! You obtained 999 Rare Candies!                ");
                            System.out.println("✨ ======================================================= ✨\n");
                        } else {
                            System.out.println("Nothing happened...");
                        }
                    }
                    break;

                case "2":
                case "map":
                    displayMap(currentRoom);
                    break;

                case "8":
                case "check":
                case "status":
                    System.out.println("--- TRAINER STATUS ---");
                    System.out.println("Trainer: " + playerName + " | Gender: " + playerGender);
                    System.out.println("Money: $" + money[0]);
                    System.out.println("Active Partner: " + activePet.name + " (Lvl " + activePet.level + " " + activePet.getTypeDisplay() + " Type)");
                    System.out.println("HP: " + activePet.hp + "/" + activePet.maxHp + " | Atk: " + activePet.attack + " | Def: " + activePet.defense);
                    System.out.println("EXP: " + activePet.exp + " / " + activePet.expToNextLevel + " (Need " + (activePet.expToNextLevel - activePet.exp) + " more for Lvl " + (activePet.level + 1) + ")");
                    System.out.println("Inventory: " + zorkBalls[0] + "x Zork Balls | " + potions[0] + "x Potions | " + rareCandies[0] + "x Rare Candies");

                    System.out.println("\n--- PARTY / ZORKMON STORAGE (" + party.size() + "/6) ---");
                    for (int i = 0; i < party.size(); i++) {
                        ZorkmonPet pet = party.get(i);
                        String activeTag = (i == activeIndex) ? " [ACTIVE]" : "";
                        String faintedTag = pet.isFainted() ? " (FAINTED)" : "";
                        System.out.println("[" + (i + 1) + "] " + pet.name + " - Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + activeTag + faintedTag);
                        System.out.print("    Moves: ");
                        for (int mIdx = 0; mIdx < pet.moves.size(); mIdx++) {
                            Move m = pet.moves.get(mIdx);
                            System.out.print(m.getName() + " (" + m.getType() + ")" + (mIdx < pet.moves.size() - 1 ? ", " : ""));
                        }
                        System.out.println();
                    }
                    System.out.println("Stored Zorkmon in PC Box: " + storageBox.size());
                    break;

                case "9":
                case "switch":
                    activeIndex = handleFieldSwitch(party, activeIndex, scanner);
                    break;

                case "10":
                case "center":
                case "pokecenter":
                case "zorkcenter":
                    if (currentRoom.equals("Accumula Town") || currentRoom.equals("Nuvema Town")) {
                        visitZorkCenter(party, storageBox, scanner);
                    } else {
                        System.out.println("There is no ZorkCenter in " + currentRoom + ". Visit Nuvema Town or Accumula Town!");
                    }
                    break;

                case "11":
                case "mart":
                case "pokemart":
                case "zorkmart":
                    if (currentRoom.equals("Accumula Town")) {
                        visitZorkMart(money, zorkBalls, potions, scanner);
                    } else {
                        System.out.println("There is no ZorkMart in " + currentRoom + ". Visit Accumula Town!");
                    }
                    break;

                case "3":
                case "go north":
                case "north":
                    if (currentRoom.equals("Nuvema Town")) {
                        currentRoom = "Route 1";
                        System.out.println("You walk north onto Route 1. Tall grass rustles nearby!");
                    } else if (currentRoom.equals("Route 1")) {
                        currentRoom = "Accumula Town";
                        System.out.println("You head north into Accumula Town, a tranquil slope city.");
                    } else if (currentRoom.equals("Accumula Town")) {
                        currentRoom = "Relic Castle";
                        System.out.println("You hike north toward the windswept ruins of Relic Castle.");
                    } else {
                        System.out.println("Dense trees and rocks block your path north.");
                    }
                    break;

                case "4":
                case "go south":
                case "south":
                    if (currentRoom.equals("Relic Castle")) {
                        currentRoom = "Accumula Town";
                        System.out.println("You walk back south to Accumula Town.");
                    } else if (currentRoom.equals("Accumula Town")) {
                        currentRoom = "Route 1";
                        System.out.println("You head south back onto Route 1.");
                    } else if (currentRoom.equals("Route 1")) {
                        currentRoom = "Nuvema Town";
                        System.out.println("You arrive back home in Nuvema Town.");
                    } else {
                        System.out.println("You look south, but ocean water stretches endlessly.");
                    }
                    break;

                case "5":
                case "go east":
                case "east":
                    if (currentRoom.equals("Route 1")) {
                        currentRoom = "Pinwheel Forest";
                        System.out.println("You step east into the misty canopy of Pinwheel Forest.");
                    } else {
                        System.out.println("You cannot go east from here.");
                    }
                    break;

                case "6":
                case "go west":
                case "west":
                    if (currentRoom.equals("Pinwheel Forest")) {
                        currentRoom = "Route 1";
                        System.out.println("You exit the forest and return to Route 1.");
                    } else {
                        System.out.println("You cannot go west from here.");
                    }
                    break;

                case "7":
                case "search":
                    if (currentRoom.equals("Route 1") || currentRoom.equals("Pinwheel Forest")) {
                        if (!itemFound) {
                            itemFound = true;
                            activePet.hp = Math.min(activePet.maxHp, activePet.hp + 30);
                            System.out.println("You search the tall grass and find an Oran Berry! " + activePet.name + " eats it and heals 30 HP.");
                        } else {
                            System.out.println("You search around, but find nothing else useful.");
                        }
                    } else {
                        System.out.println("Nothing of interest to search here.");
                    }
                    break;

                case "12":
                case "challenge":
                case "talk":
                    if (currentRoom.equals("Relic Castle")) {
                        if (!npcDefeated) {
                            npcDefeated = startTrainerBattle(party, storageBox, activeIndex, rivalParty, scanner, random, rivalName, playerGender, playerName, zorkBalls, money);
                            if (allFainted(party)) {
                                handleBlackout(party, zorkBalls, money);
                                currentRoom = "Nuvema Town";
                                activeIndex = 0;
                            }
                        } else {
                            printRivalDefeatedDialogue(rivalName, playerGender, playerName, rivalParty.get(0).name);
                        }
                    } else {
                        System.out.println("There is no trainer here to challenge.");
                    }
                    break;

                case "14":
                case "items":
                case "item":
                case "inventory":
                    handleItemsMenu(party, potions, rareCandies, scanner);
                    break;

                case "15":
                case "hunt":
                case "encounter":
                case "wild":
                    if (currentRoom.equals("Route 1") || currentRoom.equals("Pinwheel Forest")) {
                        System.out.println("You rustle through the tall grass looking for wild Zorkmon...");
                        triggerWildEncounter(currentRoom, party, storageBox, activeIndex, scanner, random, zorkBalls, money, true);
                        if (allFainted(party)) {
                            handleBlackout(party, zorkBalls, money);
                            currentRoom = "Nuvema Town";
                            activeIndex = 0;
                        }
                    } else {
                        System.out.println("There are no wild Zorkmon to hunt in " + currentRoom + ". Head to Route 1 or Pinwheel Forest!");
                    }
                    break;

                case "13":
                case "quit":
                case "exit":
                    System.out.println("Returning to Main Menu...\n");
                    running = false;
                    break;

                default:
                    System.out.println("Unknown command! Enter a number (1-15) or standard command.");
                    break;
            }

            boolean skipRandomEncounter = input.equals("13") || input.equals("quit") || input.equals("exit")
                    || input.equals("12") || input.equals("challenge")
                    || input.equals("14") || input.equals("items") || input.equals("item") || input.equals("inventory")
                    || input.equals("15") || input.equals("hunt") || input.equals("encounter") || input.equals("wild");

            if (running && !skipRandomEncounter) {
                boolean wonOrFled = triggerWildEncounter(currentRoom, party, storageBox, activeIndex, scanner, random, zorkBalls, money, false);
                if (allFainted(party)) {
                    handleBlackout(party, zorkBalls, money);
                    currentRoom = "Nuvema Town";
                    activeIndex = 0;
                }
            }

            if (npcDefeated && running) {
                System.out.println("\n*** CONGRATULATIONS " + playerName.toUpperCase() + "! You defeated " + rivalName + " and conquered Unova! ***\n");
                running = false;
            }
        }
    }

