    /**
     * Triggers wild encounters while moving in grass locations (1-in-6 chance), or immediately if forced.
     */
    private static boolean triggerWildEncounter(String room, List<ZorkmonPet> party, List<ZorkmonPet> storageBox, int activeIndex, Scanner scanner, Random random, int[] zorkBalls, int[] money, boolean forceEncounter) {
        if ((room.equals("Route 1") || room.equals("Pinwheel Forest")) && (forceEncounter || random.nextInt(6) == 0)) {
            ZorkmonPet wild;
            if (room.equals("Route 1")) {
                ZorkmonPet[] pool = {
                    new ZorkmonPet("Patrat", "Normal", null, 3, 45, 12, 10, 51, 255, Move.TACKLE),
                    new ZorkmonPet("Lillipup", "Normal", null, 4, 50, 14, 11, 55, 255, Move.BITE),
                    new ZorkmonPet("Pidove", "Normal", "Flying", 3, 48, 13, 10, 53, 255, Move.GUST)
                };
                wild = pool[random.nextInt(pool.length)];
            } else {
                ZorkmonPet[] pool = {
                    new ZorkmonPet("Sewaddle", "Bug", "Grass", 4, 55, 15, 13, 62, 255, Move.get("Bug Bite")),
                    new ZorkmonPet("Venipede", "Bug", "Poison", 4, 60, 16, 12, 52, 255, Move.get("Poison Tail")),
                    new ZorkmonPet("Joltik", "Bug", "Electric", 5, 40, 18, 9, 64, 190, Move.get("Electroweb"))
                };
                wild = pool[random.nextInt(pool.length)];
            }

            System.out.println("\n[!] A wild " + wild.name + " (" + wild.getTypeDisplay() + " Type) appeared!");
            return startSingleBattle(party, storageBox, activeIndex, wild, scanner, random, zorkBalls, money);
        }
        return false;
    }

    /**
     * Handles wild Zorkmon battle encounters.
     */
    private static boolean startSingleBattle(List<ZorkmonPet> party, List<ZorkmonPet> storageBox, int initialActiveIndex, ZorkmonPet opponent, Scanner scanner, Random random, int[] zorkBalls, int[] money) {
        System.out.println("================ BATTLE START ================");
        System.out.println("Battle against wild " + opponent.name + " (" + opponent.getTypeDisplay() + " Type)!");

        int activeIdx = initialActiveIndex;

        while (!allFainted(party) && !opponent.isFainted()) {
            ZorkmonPet player = party.get(activeIdx);

            if (player.isFainted()) {
                System.out.println("\n" + player.name + " is fainted! You must send out another Zorkmon!");
                activeIdx = forceBattleSwitch(party, activeIdx, scanner);
                player = party.get(activeIdx);
            }

            System.out.println("\n" + player.name + " HP: " + player.hp + "/" + player.maxHp + " | " + opponent.name + " HP: " + opponent.hp + "/" + opponent.maxHp);
            System.out.println("Actions: [1] Fight  [2] Catch  [3] Switch  [4] Run");
            System.out.print("Battle > ");

            String mainChoice = scanner.nextLine().trim();

            if (mainChoice.equals("4") || mainChoice.equalsIgnoreCase("run")) {
                System.out.println("You fled back to safety!");
                return false;
            }

            Move selectedMove = null;

            if (mainChoice.equals("1") || mainChoice.equalsIgnoreCase("fight")) {
                System.out.println("\n--- CHOOSE A MOVE ---");
                for (int i = 0; i < player.moves.size(); i++) {
                    Move m = player.moves.get(i);
                    System.out.println("[" + (i + 1) + "] " + m.getName() + " (" + m.getType() + " Type | Power: " + m.getPower() + " | Acc: " + m.getAccuracy() + "%)");
                }
                System.out.print("Select move (0 to go back) > ");
                try {
                    int mChoice = Integer.parseInt(scanner.nextLine().trim());
                    if (mChoice >= 1 && mChoice <= player.moves.size()) {
                        selectedMove = player.moves.get(mChoice - 1);
                    } else {
