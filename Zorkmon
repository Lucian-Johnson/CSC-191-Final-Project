    /**
     * Represents an individual Zorkmon creature instance in combat or party storage.
     * Tracks stats, level progression, experience points, species catch rates, and move set (up to 4 moves).
     */
    static class ZorkmonPet {
        String name;
        String primaryType;
        String secondaryType;
        int level;
        int hp;
        int maxHp;
        int attack;
        int defense;
        int exp;
        int expToNextLevel;
        int baseExpYield;
        int catchRate; // Base species catch rate (e.g., Patrat = 255, Joltik = 190)
        List<Move> moves;

        /**
         * Constructs a new active ZorkmonPet.
         */
        ZorkmonPet(String name, String primaryType, String secondaryType, int level, int hp, int attack, int defense, int baseExpYield, int catchRate, Move initialMove) {
            this.name = name;
            this.primaryType = primaryType;
            this.secondaryType = secondaryType;
            this.level = level;
            this.hp = hp;
            this.maxHp = hp;
            this.attack = attack;
            this.defense = defense;
            this.baseExpYield = baseExpYield;
            this.catchRate = catchRate;
            this.exp = 0;
            this.expToNextLevel = calculateExpForLevel(level + 1);
            this.moves = new ArrayList<>();
            
            // Default baseline Tackle move
            this.moves.add(Move.TACKLE);
            if (initialMove != null && !initialMove.getName().equalsIgnoreCase("Tackle")) {
                this.moves.add(initialMove);
            }
        }

        /**
         * Helper to check if Zorkmon already knows a move by name.
         */
        boolean hasMove(String moveName) {
            for (Move m : moves) {
                if (m.getName().equalsIgnoreCase(moveName)) return true;
            }
            return false;
        }

        /**
         * @return true if the Zorkmon has lost all HP
         */
        boolean isFainted() {
            return this.hp <= 0;
        }

        /**
         * Formats primary and secondary types for display output.
         */
        String getTypeDisplay() {
            return secondaryType == null ? primaryType : primaryType + "/" + secondaryType;
        }

        /**
         * Calculates total cumulative EXP required to reach a specific level using the cubic curve ($level^3$).
         */
        private static int calculateExpForLevel(int lvl) {
            return lvl * lvl * lvl;
        }

        /**
         * Awards experience points to this Zorkmon and triggers level ups if thresholds are reached.
         *
         * @param gainedExp total EXP earned from defeating or catching an opponent
         * @param scanner   scanner instance for interactive move learning choices
         */
        public void gainExp(int gainedExp, Scanner scanner) {
            this.exp += gainedExp;
            System.out.println(this.name + " gained " + gainedExp + " EXP! (" + this.exp + "/" + this.expToNextLevel + " EXP)");

            while (this.exp >= this.expToNextLevel) {
                levelUp(scanner);
            }
        }

        /**
         * Advances the Zorkmon by 1 level, boosting stats, fully restoring HP, and checking for new moves.
         */
        private void levelUp(Scanner scanner) {
            this.level++;
            this.expToNextLevel = calculateExpForLevel(this.level + 1);
            this.maxHp += 5;
            this.hp = this.maxHp;
            this.attack += 3;
            this.defense += 2;

            System.out.println("\n------------------------------------------------------------------");
            System.out.println(" LEVEL UP! " + this.name + " grew to Level " + this.level + "!");
            System.out.println(" Max HP: " + (this.maxHp - 5) + " -> " + this.maxHp + " (Fully Healed)");
            System.out.println(" Atk:    " + (this.attack - 3) + " -> " + this.attack);
            System.out.println(" Def:    " + (this.defense - 2) + " -> " + this.defense);
            System.out.println("------------------------------------------------------------------");

            checkAndLearnNewMove(scanner);
        }

        /**
         * Determines potential move learned at current level based on species and handles the learn/replace choice.
         */
        private void checkAndLearnNewMove(Scanner scanner) {
            Move newMove = getMoveForLevel(this.name, this.level);
            if (newMove == null || hasMove(newMove.getName())) {
                return;
            }

            System.out.println("\n*** " + this.name + " wants to learn " + newMove.getName() + " (" + newMove.getType() + " Type, Power: " + newMove.getPower() + ", Acc: " + newMove.getAccuracy() + "%)! ***");

            if (moves.size() < 4) {
                moves.add(newMove);
                System.out.println(this.name + " learned " + newMove.getName() + "!");
            } else {
                if (scanner == null) {
                    return; // Fallback for auto-leveling wild/NPCs
                }
                System.out.println(this.name + " already knows 4 moves:");
                for (int i = 0; i < moves.size(); i++) {
                    Move m = moves.get(i);
                    System.out.println(" [" + (i + 1) + "] " + m.getName() + " (" + m.getType() + " | Power: " + m.getPower() + ")");
                }
                System.out.println("Should " + this.name + " forget a move to learn " + newMove.getName() + "?");
                System.out.println("[1] Yes, replace an existing move");
                System.out.println("[2] No, give up on learning " + newMove.getName());
                System.out.print("Select choice > ");

                String choice = scanner.nextLine().trim();
                if (choice.equals("1") || choice.equalsIgnoreCase("yes")) {
                    System.out.println("\nWhich move should be forgotten?");
                    for (int i = 0; i < moves.size(); i++) {
                        Move m = moves.get(i);
                        System.out.println("[" + (i + 1) + "] " + m.getName() + " (" + m.getType() + ")");
                    }
                    System.out.print("Select move slot to replace (1-4, or 0 to cancel) > ");
                    try {
                        int slot = Integer.parseInt(scanner.nextLine().trim());
                        if (slot >= 1 && slot <= moves.size()) {
                            Move forgotten = moves.set(slot - 1, newMove);
                            System.out.println("1, 2, and... Poof!");
                            System.out.println(this.name + " forgot " + forgotten.getName() + " and learned " + newMove.getName() + "!");
                        } else {
                            System.out.println(this.name + " did not learn " + newMove.getName() + ".");
                        }
                    } catch (NumberFormatException e) {
                        System.out.println(this.name + " did not learn " + newMove.getName() + ".");
                    }
                } else {
                    System.out.println(this.name + " did not learn " + newMove.getName() + ".");
                }
            }
        }

        /**
         * Level-up move lookup table based on species and level threshold.
         */
        private static Move getMoveForLevel(String species, int lvl) {
            switch (species) {
                case "Snivy":
                    if (lvl == 6) return Move.get("Vine Whip");
                    if (lvl == 8) return Move.get("Mega Drain");
                    if (lvl == 10) return Move.get("Slam");
                    if (lvl == 12) return Move.get("Razor Leaf");
                    if (lvl == 15) return Move.get("Giga Drain");
                    break;
                case "Tepig":
                    if (lvl == 6) return Move.get("Ember");
                    if (lvl == 8) return Move.get("Defense Curl");
                    if (lvl == 10) return Move.get("Flame Charge");
                    if (lvl == 12) return Move.get("Take Down");
                    if (lvl == 15) return Move.get("Flamethrower");
                    break;
                case "Oshawott":
                    if (lvl == 6) return Move.get("Water Gun");
                    if (lvl == 8) return Move.get("Focus Energy");
                    if (lvl == 10) return Move.get("Razor Shell");
                    if (lvl == 12) return Move.get("Water Pulse");
                    if (lvl == 15) return Move.get("Aqua Tail");
                    break;
                case "Patrat":
                    if (lvl == 5) return Move.get("Bite");
                    if (lvl == 8) return Move.get("Super Fang");
                    if (lvl == 11) return Move.get("Crunch");
                    if (lvl == 14) return Move.get("Hyper Fang");
                    break;
                case "Lillipup":
                    if (lvl == 5) return Move.get("Bite");
                    if (lvl == 8) return Move.get("Take Down");
                    if (lvl == 11) return Move.get("Crunch");
                    if (lvl == 14) return Move.get("Play Rough");
                    break;
                case "Pidove":
                    if (lvl == 5) return Move.get("Gust");
                    if (lvl == 8) return Move.get("Quick Attack");
                    if (lvl == 11) return Move.get("Air Cutter");
                    if (lvl == 14) return Move.get("Roost");
                    break;
                case "Sewaddle":
                    if (lvl == 5) return Move.get("Bug Bite");
                    if (lvl == 8) return Move.get("Razor Leaf");
                    if (lvl == 11) return Move.get("Struggle Bug");
                    if (lvl == 14) return Move.get("Bug Buzz");
                    break;
                case "Venipede":
                    if (lvl == 5) return Move.get("Poison Tail");
                    if (lvl == 8) return Move.get("Bug Bite");
                    if (lvl == 11) return Move.get("Venoshock");
                    if (lvl == 14) return Move.get("Steamroller");
                    break;
                case "Joltik":
                    if (lvl == 6) return Move.get("Electroweb");
                    if (lvl == 9) return Move.get("Bug Bite");
                    if (lvl == 12) return Move.get("Thunder Wave");
                    if (lvl == 15) return Move.get("Discharge");
                    break;
            }
            // General filler moves for high levels
            if (lvl == 7) return Move.get("Quick Attack");
            if (lvl == 9) return Move.get("Headbutt");
            if (lvl == 13) return Move.get("Body Slam");
            if (lvl == 16) return Move.get("Slash");
            return null;
        }
    }

