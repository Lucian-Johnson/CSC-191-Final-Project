            System.out.println("[3] Back to Overworld");
            System.out.print("Select item to use > ");

            String choice = scanner.nextLine().trim();
            switch (choice) {
                case "1":
                    usePotion(party, potions, scanner);
                    break;
                case "2":
                    useRareCandy(party, rareCandies, scanner);
                    break;
