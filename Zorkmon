    /**
     * Main combat turn loop for handling attacks, capturing, switching, and running.
     *
     * @return true if the player wins or catches the opponent; false if player flees or faints
     */
    private static boolean startBattle(List<ZorkmonPet> party, int initialActiveIndex, ZorkmonPet opponent, Scanner scanner, Random random, String rivalName, String playerGender, String playerName, int[] zorkBalls, int[] money, boolean isTrainerBattle) {
        System.out.println("================ BATTLE START ================");
        if (isTrainerBattle) {
            printRivalBattleStartDialogue(rivalName, playerGender, playerName, opponent.name);
        } else {
            System.out.println("Battle against wild " + opponent.name + " (" + opponent.getTypeDisplay() + " Type)!");
        }

        int activeIdx = initialActiveIndex;

        while (!allFainted(party) && !opponent.isFainted()) {
            ZorkmonPet player = party.get(activeIdx);

            // Auto-switch prompt if active Zorkmon has fainted
            if (player.isFainted()) {
                System.out.println("\n" + player.name + " is fainted! You must send out another Zorkmon!");
                activeIdx = forceBattleSwitch(party, activeIdx, scanner);
                player = party.get(activeIdx);
            }

            System.out.println("\n" + player.name + " HP: " + player.hp + "/" + player.maxHp + " | " + opponent.name + " HP: " + opponent.hp + "/" + opponent.maxHp);
            System.out.println("Choose action: [1] Tackle  [2] " + player.specialMove.getName() + " (" + player.specialMove.getType() + ")  [3] Catch  [4] Switch  [5] Run");
            System.out.print("Battle > ");

            String choice = scanner.nextLine().trim();

            if (choice.equals("5") || choice.equalsIgnoreCase("run")) {
                if (isTrainerBattle) {
                    System.out.println("You can't run from a Trainer battle!");
                    continue;
                }
                System.out.println("You fled back to safety!");
                return false;
            }

            // --- Catch Action ---
            if (choice.equals("3") || choice.equalsIgnoreCase("catch")) {
                if (isTrainerBattle) {
                    System.out.println("\n" + rivalName + ": \"Hey! Don't try to steal another Trainer's Zorkmon!\"");
                    System.out.println(">>> You cannot catch a Zorkmon that belongs to another Trainer! <<<");
                } else if (zorkBalls[0] <= 0) {
                    System.out.println("\nYou don't have any Zork Balls left!");
                } else {
                    zorkBalls[0]--;
                    System.out.println("\nYou threw a Zork Ball! (Remaining Zork Balls: " + zorkBalls[0] + ")");
                    boolean caught = attemptCatch(opponent, 1.0, 1.0, random);
                    if (caught) {
                        System.out.println("Gotcha! " + opponent.name + " was caught!");
                        party.add(opponent);

                        // Award EXP and prize money upon successful capture
                        int expGained = (opponent.baseExpYield * opponent.level) / 7;
                        int prizeMoney = opponent.level * 40;
                        money[0] += prizeMoney;
                        System.out.println("\n" + player.name + " earned EXP for catching " + opponent.name + "!");
                        System.out.println("You collected $" + prizeMoney + " after the battle!");
                        player.gainExp(expGained);
                        return true;
                    } else {
                        System.out.println("Oh no! The Zorkmon broke free!");
                    }
                }
            } else if (choice.equals("4") || choice.equalsIgnoreCase("switch")) {
                // --- In-Battle Switch Option ---
                int newIdx = handleInBattleSwitch(party, activeIdx, scanner);
                if (newIdx != activeIdx) {
                    activeIdx = newIdx;
                    player = party.get(activeIdx);
                    System.out.println("Go! " + player.name + "!");
                } else {
                    continue; // Cancelled switch, repeat choice
                }
            } else {
                // --- Player Attack Turn ---
                int playerDamage = 0;
                if (choice.equals("1") || choice.equalsIgnoreCase("tackle")) {
                    playerDamage = calculateFormulaDamage(player, opponent, Move.TACKLE, random);
                    System.out.println("\n" + player.name + " used Tackle!");
                } else if (choice.equals("2") || choice.equalsIgnoreCase(player.specialMove.getName())) {
                    playerDamage = calculateFormulaDamage(player, opponent, player.specialMove, random);

                    double typeMod = getFullTypeMultiplier(player.specialMove.getType(), opponent.primaryType, opponent.secondaryType);
                    System.out.print("\n" + player.name + " used " + player.specialMove.getName() + "! ");
                    if (typeMod > 1.0) {
                        System.out.println("It's super effective!");
                    } else if (typeMod == 0.0) {
                        System.out.println("It had no effect!");
                    } else if (typeMod < 1.0) {
                        System.out.println("It's not very effective...");
                    } else {
                        System.out.println();
                    }
                } else {
                    System.out.println("Invalid choice! You stumbled and lost your turn!");
                }

                if (playerDamage > 0) {
                    opponent.hp = Math.max(0, opponent.hp - playerDamage);
                    System.out.println(opponent.name + " took " + playerDamage + " damage!");
                }

                if (opponent.isFainted()) {
                    System.out.println("\n" + opponent.name + " fainted! You won the battle!");

                    int expGained = (opponent.baseExpYield * opponent.level) / 7;
                    int prizeMoney = opponent.level * (isTrainerBattle ? 200 : 50);
                    money[0] += prizeMoney;
                    System.out.println("You won $" + prizeMoney + " in prize money!");
                    player.gainExp(expGained);
                    return true;
                }
            }

            // --- Opponent Counterattack Turn ---
            System.out.println("\n" + opponent.name + " attacks!");
            int oppDamage = calculateFormulaDamage(opponent, player, opponent.specialMove, random);

            double oppTypeMod = getFullTypeMultiplier(opponent.specialMove.getType(), player.primaryType, player.secondaryType);
            System.out.print(opponent.name + " used " + opponent.specialMove.getName() + "! ");
            if (oppTypeMod > 1.0) {
                System.out.println("It's super effective!");
            } else if (oppTypeMod == 0.0) {
                System.out.println("It had no effect!");
            } else if (oppTypeMod < 1.0) {
                System.out.println("It's not very effective...");
            } else {
                System.out.println();
            }

            player.hp = Math.max(0, player.hp - oppDamage);
            System.out.println(player.name + " took " + oppDamage + " damage!");
        }

        return false;
    }

    /**
     * Prompts player to voluntarily switch active Zorkmon during battle.
     */
    private static int handleInBattleSwitch(List<ZorkmonPet> party, int currentIdx, Scanner scanner) {
        if (party.size() <= 1) {
            System.out.println("You have no other Zorkmon in your party to switch to!");
            return currentIdx;
        }

        System.out.println("\n--- SWITCH ZORKMON ---");
        for (int i = 0; i < party.size(); i++) {
            ZorkmonPet pet = party.get(i);
            String statusStr = (i == currentIdx) ? " [IN BATTLE]" : "";
            if (pet.isFainted()) statusStr += " (FAINTED)";
            System.out.println("[" + (i + 1) + "] " + pet.name + " (Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + ")" + statusStr);
        }
        System.out.print("Choose Zorkmon to send out (or 0 to cancel) > ");
        try {
            int sel = Integer.parseInt(scanner.nextLine().trim());
            if (sel > 0 && sel <= party.size()) {
                int targetIdx = sel - 1;
                if (targetIdx == currentIdx) {
                    System.out.println(party.get(targetIdx).name + " is already in battle!");
                } else if (party.get(targetIdx).isFainted()) {
                    System.out.println(party.get(targetIdx).name + " is fainted and cannot battle!");
                } else {
                    return targetIdx;
                }
            }
        } catch (NumberFormatException e) {
            System.out.println("Invalid selection!");
        }
        return currentIdx;
    }

    /**
     * Forces the player to choose a non-fainted Zorkmon when the active one faints in battle.
     */
    private static int forceBattleSwitch(List<ZorkmonPet> party, int currentIdx, Scanner scanner) {
        System.out.println("\n--- CHOOSE NEXT ZORKMON ---");
        for (int i = 0; i < party.size(); i++) {
            ZorkmonPet pet = party.get(i);
            if (!pet.isFainted()) {
                System.out.println("[" + (i + 1) + "] " + pet.name + " (Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + ")");
            }
        }
        while (true) {
            System.out.print("Select next Zorkmon > ");
            try {
                int sel = Integer.parseInt(scanner.nextLine().trim());
                if (sel > 0 && sel <= party.size() && !party.get(sel - 1).isFainted()) {
                    return sel - 1;
                }
            } catch (NumberFormatException ignored) {}
            System.out.println("Invalid choice! Choose an active Zorkmon.");
        }
    }

    // =========================================================================
    // CATCHING MECHANICS & FORMULAS
    // =========================================================================

    /**
     * Calculates capture success using the Gen III/IV formula:
     * $$a = \frac{(3 \times MaxHP - 2 \times CurrentHP) \times CatchRate \times BallBonus}{3 \times MaxHP} \times StatusBonus$$
     * Followed by computing $b = 65536 \times (a / 255)^{0.25}$ for up to 4 shake checks.
     *
     * @param target      wild Zorkmon being caught
     * @param ballBonus   multiplier for ball type (e.g., 1.0 for standard Zork Ball)
     * @param statusBonus multiplier for status condition (e.g., 1.0 for none)
     * @param random      random number generator instance
     * @return true if target was successfully captured
     */
    private static boolean attemptCatch(ZorkmonPet target, double ballBonus, double statusBonus, Random random) {
        // Calculate modified catch value 'a'
        double a = (((3.0 * target.maxHp - 2.0 * target.hp) * target.catchRate * ballBonus) / (3.0 * target.maxHp)) * statusBonus;

        if (a >= 255.0) {
            System.out.println("Shake... Shake... Shake... Click!");
            return true;
        }

        // Calculate shake probability check 'b'
        double b = 65536.0 * Math.pow(a / 255.0, 0.25);

        // Perform up to 4 shake checks
        for (int shake = 1; shake <= 4; shake++) {
            int randomRoll = random.nextInt(65536);
            if (randomRoll >= (int) b) {
                for (int s = 1; s < shake; s++) {
                    System.out.println("Shake...");
                }
                return false;
            }
        }

        System.out.println("Shake... Shake... Shake... Click!");
        return true;
    }

