public class Zorkmon {

    // Active Zorkmon Class featuring EXP & Leveling
    static class ZorkmonPet {
        String name;
        String primaryType;
        String secondaryType;
        int level;
        int hp;
        int maxHp;
        int attack;
        int defense;
        int exp;
        int expToNextLevel;
        int baseExpYield;
        Move specialMove;

        ZorkmonPet(String name, String primaryType, String secondaryType, int level, int hp, int attack, int defense, int baseExpYield, Move specialMove) {
            this.name = name;
            this.primaryType = primaryType;
            this.secondaryType = secondaryType;
            this.level = level;
            this.hp = hp;
            this.maxHp = hp;
            this.attack = attack;
            this.defense = defense;
            this.baseExpYield = baseExpYield;
            this.exp = 0;
            this.expToNextLevel = calculateExpForLevel(level + 1);
            this.specialMove = specialMove;
        }

        boolean isFainted() {
            return this.hp <= 0;
        }

        String getTypeDisplay() {
            return secondaryType == null ? primaryType : primaryType + "/" + secondaryType;
        }

        private static int calculateExpForLevel(int lvl) {
            return lvl * lvl * lvl;
        }

        public void gainExp(int gainedExp) {
            this.exp += gainedExp;
            System.out.println(this.name + " gained " + gainedExp + " EXP! (" + this.exp + "/" + this.expToNextLevel + " EXP)");

            while (this.exp >= this.expToNextLevel) {
                levelUp();
            }
        }

        private void levelUp() {
            this.level++;
            this.expToNextLevel = calculateExpForLevel(this.level + 1);
            this.maxHp += 5;
            this.hp = this.maxHp;
            this.attack += 3;
            this.defense += 2;

            System.out.println("\n------------------------------------------------------------------");
            System.out.println(" LEVEL UP! " + this.name + " grew to Level " + this.level + "!");
            System.out.println(" Max HP: " + (this.maxHp - 5) + " -> " + this.maxHp + " (Fully Healed)");
            System.out.println(" Atk:    " + (this.attack - 3) + " -> " + this.attack);
            System.out.println(" Def:    " + (this.defense - 2) + " -> " + this.defense);
            System.out.println("------------------------------------------------------------------");
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        boolean inApp = true;

        while (inApp) {
            System.out.println("=========================================");
            System.out.println("      WELCOME TO ZORKMON: UNOVA          ");
            System.out.println("=========================================");
            System.out.println("1. Start Game");
            System.out.println("2. Open Zorkdex");
            System.out.println("3. Exit Program");
            System.out.print("Select an option > ");

            String mainChoice = scanner.nextLine().trim();

            switch (mainChoice) {
                case "1":
                    runGame(scanner, random);
                    break;
                case "2":
                    openZorkdex(scanner);
                    break;
                case "3":
                    System.out.println("Thanks for playing Zorkmon! Goodbye!");
                    inApp = false;
                    break;
                default:
                    System.out.println("Invalid choice! Please enter 1, 2, or 3.\n");
                    break;
            }
        }

        scanner.close();
    }

    private static void openZorkdex(Scanner scanner) {
        boolean inZorkdex = true;
        while (inZorkdex) {
            System.out.println("\n--- ZORKDEX ---");
            System.out.println("1. Display All Zorkdex Entries");
            System.out.println("2. Search Zorkdex by Name");
            System.out.println("3. Search Zorkdex by Number");
            System.out.println("4. Filter Zorkdex by Type");
            System.out.println("5. Return to Main Menu");
            System.out.print("Choose an option > ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1":
                    System.out.println("\n--- All Zorkdex Entries (#000 - #155) ---");
                    for (ZorkdexEntry zorkdexEntry : ZorkdexEntry.getAllEntries()) {
                        System.out.println(zorkdexEntry);
                    }
                    break;
                case "2":
                    System.out.print("Enter name to search in Zorkdex: ");
                    String zorkdexSearchName = scanner.nextLine().trim();
                    List<ZorkdexEntry> zorkdexNameMatches = ZorkdexEntry.getAllEntries().stream()
                            .filter(p -> p.getName().equalsIgnoreCase(zorkdexSearchName))
                            .collect(Collectors.toList());
                    if (zorkdexNameMatches.isEmpty()) {
                        System.out.println("No Zorkdex entry found matching: " + zorkdexSearchName);
                    } else {
                        zorkdexNameMatches.forEach(System.out::println);
                    }
                    break;
                case "3":
                    System.out.print("Enter Zorkdex number (000-155): ");
                    try {
                        int zorkdexNum = Integer.parseInt(scanner.nextLine().trim());
                        ZorkdexEntry.getAllEntries().stream()
                                .filter(p -> p.getId() == zorkdexNum)
                                .findFirst()
                                .ifPresentOrElse(
                                        System.out::println,
                                        () -> System.out.println("No Zorkdex entry with #" + String.format("%03d", zorkdexNum))
                                );
                    } catch (NumberFormatException e) {
                        System.out.println("Invalid number format!");
                    }
                    break;
                case "4":
                    System.out.print("Enter type (e.g. Fire, Dragon, Bug): ");
                    String zorkdexType = scanner.nextLine().trim();
                    List<ZorkdexEntry> zorkdexTypeMatches = ZorkdexEntry.getAllEntries().stream()
                            .filter(p -> p.getPrimaryType().equalsIgnoreCase(zorkdexType) ||
                                         (p.getSecondaryType() != null && p.getSecondaryType().equalsIgnoreCase(zorkdexType)))
                            .collect(Collectors.toList());
                    if (zorkdexTypeMatches.isEmpty()) {
                        System.out.println("No Zorkdex entries found with type: " + zorkdexType);
                    } else {
                        System.out.printf("\n--- %s Type Zorkdex Entries (%d found) ---\n", zorkdexType, zorkdexTypeMatches.size());
                        zorkdexTypeMatches.forEach(System.out::println);
                    }
                    break;
                case "5":
                    inZorkdex = false;
                    System.out.println("Closing Zorkdex...\n");
                    break;
                default:
                    System.out.println("Invalid choice! Please pick 1-5.");
                    break;
            }
        }
    }

    private static void runGame(Scanner scanner, Random random) {
        System.out.println("\n------------------------------------------------------------------");
        System.out.println("                 STARTING ZORKMON ADVENTURE                       ");
        System.out.println("------------------------------------------------------------------");

        System.out.print("Hello there! Welcome to the world of Zorkmon! What is your name? ");
        String playerName = scanner.nextLine().trim();
        if (playerName.isEmpty()) {
            playerName = "Hero";
        }

        String playerGender = "";
        while (true) {
            System.out.println("\nAre you:");
            System.out.println("[1] Boy");
            System.out.println("[2] Girl");
            System.out.println("[3] Non-binary");
            System.out.print("Selection > ");

            String genderChoice = scanner.nextLine().trim();
            if (genderChoice.equals("1") || genderChoice.equalsIgnoreCase("boy")) {
                playerGender = "Boy";
                break;
            } else if (genderChoice.equals("2") || genderChoice.equalsIgnoreCase("girl")) {
                playerGender = "Girl";
                break;
            } else if (genderChoice.equals("3") || genderChoice.equalsIgnoreCase("non-binary") || genderChoice.equalsIgnoreCase("nonbinary")) {
                playerGender = "Non-binary";
                break;
            } else {
                System.out.println("Invalid selection! Please choose 1, 2, or 3.");
            }
        }

        System.out.print("\nAnd what is the name of your rival? ");
        String rivalName = scanner.nextLine().trim();
        if (rivalName.isEmpty()) {
            rivalName = "Cheren";
        }

        System.out.println("\nWelcome, " + playerName + "! Your journey begins now alongside your rival, " + rivalName + "!");

        ZorkmonPet player = chooseStarter(scanner);

        List<ZorkmonPet> remainingStarters = new ArrayList<>();
        if (!player.name.equals("Snivy")) {
            remainingStarters.add(new ZorkmonPet("Snivy", "Grass", null, 5, 100, 20, 15, 62, Move.VINE_WHIP));
        }
        if (!player.name.equals("Tepig")) {
            remainingStarters.add(new ZorkmonPet("Tepig", "Fire", null, 5, 85, 22, 12, 62, Move.EMBER));
        }
        if (!player.name.equals("Oshawott")) {
            remainingStarters.add(new ZorkmonPet("Oshawott", "Water", null, 5, 110, 18, 14, 62, Move.WATER_GUN));
        }

        ZorkmonPet npc = remainingStarters.get(random.nextInt(remainingStarters.size()));

        System.out.println("\nYou chose " + player.name + "!");
        System.out.println(rivalName + " chose " + npc.name + "!");

        String currentRoom = "Nuvema Town";
        boolean itemFound = false;
        boolean npcDefeated = false;

        boolean running = true;
        while (running) {
            System.out.println("\n------------------------------------------------------------------");
            System.out.println("[ Location: " + currentRoom + " ]");
            System.out.println("Available Commands: 'look', 'map', 'go north', 'go south', 'go east', 'go west', 'search', 'check', 'challenge', or 'quit'");
            System.out.print("> ");
            String input = scanner.nextLine().trim().toLowerCase();

            switch (input) {
                case "look":
                    describeRoom(currentRoom, npc, itemFound, npcDefeated, rivalName);
                    break;

                case "map":
                    displayMap(currentRoom);
                    break;

                case "check":
                    System.out.println("--- TRAINER STATUS ---");
                    System.out.println("Trainer: " + playerName + " | Gender: " + playerGender);
                    System.out.println("Partner: " + player.name + " (Lvl " + player.level + " " + player.getTypeDisplay() + " Type)");
                    System.out.println("HP: " + player.hp + "/" + player.maxHp + " | Atk: " + player.attack + " | Def: " + player.defense);
                    System.out.println("EXP: " + player.exp + " / " + player.expToNextLevel + " (Need " + (player.expToNextLevel - player.exp) + " more for Lvl " + (player.level + 1) + ")");
                    break;

                case "go north":
                    if (currentRoom.equals("Nuvema Town")) {
                        currentRoom = "Route 1";
                        System.out.println("You walk north onto Route 1. Tall grass rustles nearby!");
                    } else if (currentRoom.equals("Route 1")) {
                        currentRoom = "Accumula Town";
                        System.out.println("You head north into Accumula Town, a tranquil slope city.");
                    } else if (currentRoom.equals("Accumula Town")) {
                        currentRoom = "Relic Castle";
                        System.out.println("You hike north toward the windswept ruins of Relic Castle.");
                    } else {
                        System.out.println("Dense trees and rocks block your path north.");
                    }
                    break;

                case "go south":
                    if (currentRoom.equals("Relic Castle")) {
                        currentRoom = "Accumula Town";
                        System.out.println("You walk back south to Accumula Town.");
                    } else if (currentRoom.equals("Accumula Town")) {
                        currentRoom = "Route 1";
                        System.out.println("You head south back onto Route 1.");
                    } else if (currentRoom.equals("Route 1")) {
                        currentRoom = "Nuvema Town";
                        System.out.println("You arrive back home in Nuvema Town.");
                    } else {
                        System.out.println("You look south, but ocean water stretches endlessly.");
                    }
                    break;

                case "go east":
                    if (currentRoom.equals("Route 1")) {
                        currentRoom = "Pinwheel Forest";
                        System.out.println("You step east into the misty canopy of Pinwheel Forest.");
                    } else {
                        System.out.println("You cannot go east from here.");
                    }
                    break;

                case "go west":
                    if (currentRoom.equals("Pinwheel Forest")) {
                        currentRoom = "Route 1";
                        System.out.println("You exit the forest and return to Route 1.");
                    } else {
                        System.out.println("You cannot go west from here.");
                    }
                    break;

                case "search":
                    if (currentRoom.equals("Route 1") || currentRoom.equals("Pinwheel Forest")) {
                        if (!itemFound) {
                            itemFound = true;
                            player.hp = Math.min(player.maxHp, player.hp + 30);
                            System.out.println("You search the tall grass and find an Oran Berry! " + player.name + " eats it and heals 30 HP.");
                        } else {
                            System.out.println("You search around, but find nothing else useful.");
                        }
                    } else {
                        System.out.println("Nothing of interest to search here.");
                    }
                    break;

                case "challenge":
                case "talk":
                    if (currentRoom.equals("Relic Castle")) {
                        if (!npcDefeated) {
                            npcDefeated = startBattle(player, npc, scanner, random, rivalName, playerGender, playerName);
                            if (player.isFainted()) {
                                System.out.println("\n" + player.name + " fainted... GAME OVER.");
                                running = false;
                            }
                        } else {
                            printRivalDefeatedDialogue(rivalName, playerGender, playerName, npc.name);
                        }
                    } else {
                        System.out.println("There is no trainer here to challenge.");
                    }
                    break;

                case "quit":
                    System.out.println("Returning to Main Menu...\n");
                    running = false;
                    break;

                default:
                    System.out.println("Unknown command. Please try one of the commands listed above.");
                    break;
            }

            if (running && !input.equals("quit") && !input.equals("challenge")) {
                triggerWildEncounter(currentRoom, player, scanner, random);
            }

            if (npcDefeated && running) {
                System.out.println("\n*** CONGRATULATIONS " + playerName.toUpperCase() + "! You defeated " + rivalName + " and conquered Unova! ***\n");
                running = false;
            }
        }
    }

