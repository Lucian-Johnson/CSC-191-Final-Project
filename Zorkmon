    private static void usePotion(List<ZorkmonPet> party, int[] potions, Scanner scanner) {
        if (potions[0] <= 0) {
            System.out.println("You don't have any Potions!");
            return;
        }

        System.out.println("\n--- USE POTION (" + potions[0] + " Remaining) ---");
        for (int i = 0; i < party.size(); i++) {
            ZorkmonPet pet = party.get(i);
            System.out.println("[" + (i + 1) + "] " + pet.name + pet.getStatusTag() + " (HP: " + pet.hp + "/" + pet.maxHp + ")");
        }
        System.out.print("Select Zorkmon to heal (0 to cancel) > ");
        try {
            int slot = Integer.parseInt(scanner.nextLine().trim());
            if (slot >= 1 && slot <= party.size()) {
                ZorkmonPet pet = party.get(slot - 1);
                if (pet.hp >= pet.maxHp) {
                    System.out.println(pet.name + " is already at full HP!");
                } else {
                    potions[0]--;
                    int healAmount = Math.min(20, pet.maxHp - pet.hp);
                    pet.hp += healAmount;
                    System.out.println("Used a Potion on " + pet.name + "! Restored " + healAmount + " HP. (" + pet.hp + "/" + pet.maxHp + " HP)");
                }
            }
        } catch (NumberFormatException e) {
            System.out.println("Invalid selection!");
        }
    }

    private static void useRareCandy(List<ZorkmonPet> party, int[] rareCandies, Scanner scanner) {
        if (rareCandies[0] <= 0) {
            System.out.println("You don't have any Rare Candies!");
            return;
        }

        System.out.println("\n--- USE RARE CANDY (" + rareCandies[0] + " Remaining) ---");
        for (int i = 0; i < party.size(); i++) {
            ZorkmonPet pet = party.get(i);
            System.out.println("[" + (i + 1) + "] " + pet.name + pet.getStatusTag() + " (Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + ")");
        }
        System.out.print("Select Zorkmon to feed Rare Candy (0 to cancel) > ");
        try {
            int slot = Integer.parseInt(scanner.nextLine().trim());
            if (slot >= 1 && slot <= party.size()) {
                ZorkmonPet pet = party.get(slot - 1);
