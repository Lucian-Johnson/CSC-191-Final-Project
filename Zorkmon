    /**
     * Fully restores HP for all Zorkmon in the player's party.
     */
    private static void visitZorkCenter(List<ZorkmonPet> party) {
        System.out.println("\n================ ZORKMON CENTER ================");
        System.out.println("Nurse Joy: \"Welcome to the Zorkmon Center! We restore your tired Zorkmon to full health.\"");
        System.out.println("Nurse Joy takes your party...");
        for (ZorkmonPet pet : party) {
            pet.hp = pet.maxHp;
        }
        System.out.println("Ding-ding-ding-ding-ding!");
        System.out.println("Nurse Joy: \"Thank you for waiting! Your Zorkmon are fully rested and healed to Max HP!\"");
        System.out.println("================================================\n");
    }

    /**
     * Interactive shop interface for purchasing Zork Balls ($200) and Potions ($300).
     */
    private static void visitZorkMart(int[] money, int[] zorkBalls, int[] potions, Scanner scanner) {
        boolean inMart = true;
        while (inMart) {
            System.out.println("\n=================== ZORKMART ===================");
            System.out.println("Clerk: \"Welcome to the ZorkMart! How can I help you today?\"");
            System.out.println("Your Wallet: $" + money[0]);
            System.out.println("1. Zork Ball  - $200 (Catches wild Zorkmon)");
            System.out.println("2. Potion     - $300 (Restores 20 HP in battle)");
            System.out.println("3. Exit ZorkMart");
            System.out.print("Select an option > ");

            String choice = scanner.nextLine().trim();
            switch (choice) {
                case "1":
                    if (money[0] >= 200) {
                        money[0] -= 200;
                        zorkBalls[0]++;
                        System.out.println("Bought 1x Zork Ball! (Remaining Money: $" + money[0] + ", Total Zork Balls: " + zorkBalls[0] + ")");
                    } else {
                        System.out.println("Clerk: \"Sorry, you don't have enough money for a Zork Ball!\"");
                    }
                    break;
                case "2":
                    if (money[0] >= 300) {
                        money[0] -= 300;
                        potions[0]++;
                        System.out.println("Bought 1x Potion! (Remaining Money: $" + money[0] + ", Total Potions: " + potions[0] + ")");
                    } else {
                        System.out.println("Clerk: \"Sorry, you don't have enough money for a Potion!\"");
                    }
                    break;
                case "3":
                    System.out.println("Clerk: \"Please come again!\"");
                    inMart = false;
                    break;
                default:
                    System.out.println("Invalid selection!");
                    break;
            }
        }
    }

    // =========================================================================
