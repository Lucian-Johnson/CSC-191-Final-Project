    // DAMAGE CALCULATIONS & TYPE CHART
    // =========================================================================

    /**
     * Calculates final move damage using the standard damage formula:
     * $$Damage = \left( \frac{\frac{2 \times Level}{5} + 2 \times Power \times Attack / Defense}{50} + 2 \right) \times Critical \times Random \times STAB \times Type$$
     */
    private static int calculateFormulaDamage(ZorkmonPet attacker, ZorkmonPet defender, Move move, Random random) {
        int baseLevelCalc = (2 * attacker.level) / 5 + 2;
        int basePowerCalc = (baseLevelCalc * move.getPower() * attacker.attack) / defender.defense;
        int baseDamage = (basePowerCalc / 50) + 2;

        boolean isCrit = random.nextInt(16) == 0;
        double critical = isCrit ? 1.5 : 1.0;
        if (isCrit) {
            System.out.println("A critical hit!");
        }

        double randomRoll = (85 + random.nextInt(16)) / 100.0;
        double stab = (attacker.primaryType.equalsIgnoreCase(move.getType()) || (attacker.secondaryType != null && attacker.secondaryType.equalsIgnoreCase(move.getType()))) ? 1.5 : 1.0;
        double type = getFullTypeMultiplier(move.getType(), defender.primaryType, defender.secondaryType);

        double finalDamage = baseDamage * critical * randomRoll * stab * type;
        return Math.max(1, (int) finalDamage);
    }

    /**
     * Computes cumulative type multiplier against dual-type defenders.
     */
    private static double getFullTypeMultiplier(String moveType, String defType1, String defType2) {
        double mult = getSingleTypeMultiplier(moveType, defType1);
        if (defType2 != null) {
            mult *= getSingleTypeMultiplier(moveType, defType2);
        }
        return mult;
    }

    /**
     * Computes single-type chart effectiveness multiplier (0.0x, 0.5x, 1.0x, 2.0x).
     */
    private static double getSingleTypeMultiplier(String attacker, String defender) {
        if (attacker == null || defender == null) return 1.0;
        attacker = attacker.trim();
        defender = defender.trim();

        switch (attacker) {
            case "Normal":
                if (defender.equals("Rock") || defender.equals("Steel")) return 0.5;
                if (defender.equals("Ghost")) return 0.0;
                break;
            case "Fire":
                if (defender.equals("Grass") || defender.equals("Ice") || defender.equals("Bug") || defender.equals("Steel")) return 2.0;
                if (defender.equals("Fire") || defender.equals("Water") || defender.equals("Rock") || defender.equals("Dragon")) return 0.5;
                break;
            case "Water":
                if (defender.equals("Fire") || defender.equals("Ground") || defender.equals("Rock")) return 2.0;
                if (defender.equals("Water") || defender.equals("Grass") || defender.equals("Dragon")) return 0.5;
                break;
            case "Grass":
                if (defender.equals("Water") || defender.equals("Ground") || defender.equals("Rock")) return 2.0;
                if (defender.equals("Fire") || defender.equals("Grass") || defender.equals("Poison") || defender.equals("Flying") || defender.equals("Bug") || defender.equals("Dragon") || defender.equals("Steel")) return 0.5;
                break;
            case "Electric":
                if (defender.equals("Water") || defender.equals("Flying")) return 2.0;
                if (defender.equals("Electric") || defender.equals("Grass") || defender.equals("Dragon")) return 0.5;
                if (defender.equals("Ground")) return 0.0;
                break;
            case "Ice":
                if (defender.equals("Grass") || defender.equals("Ground") || defender.equals("Flying") || defender.equals("Dragon")) return 2.0;
                if (defender.equals("Fire") || defender.equals("Water") || defender.equals("Ice") || defender.equals("Steel")) return 0.5;
                break;
            case "Fighting":
                if (defender.equals("Normal") || defender.equals("Ice") || defender.equals("Rock") || defender.equals("Dark") || defender.equals("Steel")) return 2.0;
                if (defender.equals("Poison") || defender.equals("Flying") || defender.equals("Psychic") || defender.equals("Bug")) return 0.5;
                if (defender.equals("Ghost")) return 0.0;
                break;
            case "Poison":
                if (defender.equals("Grass")) return 2.0;
                if (defender.equals("Poison") || defender.equals("Ground") || defender.equals("Rock") || defender.equals("Ghost")) return 0.5;
                if (defender.equals("Steel")) return 0.0;
                break;
            case "Ground":
                if (defender.equals("Fire") || defender.equals("Electric") || defender.equals("Poison") || defender.equals("Rock") || defender.equals("Steel")) return 2.0;
                if (defender.equals("Grass") || defender.equals("Bug")) return 0.5;
                if (defender.equals("Flying")) return 0.0;
                break;
            case "Flying":
                if (defender.equals("Grass") || defender.equals("Fighting") || defender.equals("Bug")) return 2.0;
                if (defender.equals("Electric") || defender.equals("Rock") || defender.equals("Steel")) return 0.5;
                break;
            case "Psychic":
                if (defender.equals("Fighting") || defender.equals("Poison")) return 2.0;
                if (defender.equals("Psychic") || defender.equals("Steel")) return 0.5;
                if (defender.equals("Dark")) return 0.0;
                break;
            case "Bug":
                if (defender.equals("Grass") || defender.equals("Psychic") || defender.equals("Dark")) return 2.0;
                if (defender.equals("Fire") || defender.equals("Fighting") || defender.equals("Poison") || defender.equals("Flying") || defender.equals("Ghost") || defender.equals("Steel")) return 0.5;
                break;
            case "Rock":
                if (defender.equals("Fire") || defender.equals("Ice") || defender.equals("Flying") || defender.equals("Bug")) return 2.0;
                if (defender.equals("Fighting") || defender.equals("Ground") || defender.equals("Steel")) return 0.5;
                break;
            case "Ghost":
                if (defender.equals("Psychic") || defender.equals("Ghost")) return 2.0;
                if (defender.equals("Dark")) return 0.5;
                if (defender.equals("Normal")) return 0.0;
                break;
            case "Dragon":
                if (defender.equals("Dragon")) return 2.0;
                if (defender.equals("Steel")) return 0.5;
                break;
            case "Steel":
                if (defender.equals("Ice") || defender.equals("Rock")) return 2.0;
                if (defender.equals("Fire") || defender.equals("Water") || defender.equals("Electric") || defender.equals("Steel")) return 0.5;
                break;
            case "Dark":
                if (defender.equals("Psychic") || defender.equals("Ghost")) return 2.0;
                if (defender.equals("Fighting") || defender.equals("Dark")) return 0.5;
                break;
        }
        return 1.0;
    }

