package zorkmon;

import java.util.ArrayList;
import java.util.List;
import java.util.Random;
import java.util.Scanner;
import java.util.stream.Collectors;
import zorkmon.ZorkdexData.Evolution;
import zorkmon.ZorkdexData.Move;
import zorkmon.ZorkdexData.ZorkdexEntry;

/**
 * Zorkmon: Unova Edition — Main Game Engine & Controller.
 * <p>
 * Implements a command-line RPG featuring:
 * <ul>
 *   <li>Professor Juniper story introduction & starter selection</li>
 *   <li>Turn-based combat with damage formula calculation, critical hits, STAB, full 17-type chart match-ups, and secondary status/volatile effects</li>
 *   <li>Move sets up to 4 moves with level-up move learning & move replacement mechanics</li>
 *   <li>Level-based evolution prompts with cancellation and re-prompting at subsequent level-ups</li>
 *   <li>Generation III/IV modified capture formula mechanics ($a$ &amp; $b$ threshold shake checks with status bonuses)</li>
 *   <li>In-battle and field Zorkmon switching across the player's active party (max 6)</li>
 *   <li>Blackout / Whiteout restart system on total party fainting</li>
 *   <li>Economy system (Money, ZorkMart, ZorkCenter healing, and item purchasing)</li>
 *   <li>PC Storage Box system accessible at ZorkCenters</li>
 *   <li>Zorkdex viewer with search and filtering capabilities</li>
 *   <li>Relic Castle riddle prompt for Rare Candies & Morse code secret for Level 99 Regigigas</li>
 *   <li>Pinwheel Forest Bug Catcher trainer battle</li>
 *   <li>Unified Bag/Items Menu ([14] Items) supporting both Potions and Rare Candies</li>
 *   <li>Forced Wild Encounter / Hunt action ([15] Hunt) in wild grass areas</li>
 * </ul>
 * 
 * @author lucia
 */
public class Zorkmon {

    // =========================================================================
    // ACTIVE ZORKMON CLASS
    // =========================================================================

    /**
     * Represents an individual Zorkmon creature instance in combat or party storage.
     * Tracks stats, status conditions, level progression, experience points, catch rates, and move set.
     */
    static class ZorkmonPet {
        String name;
        String primaryType;
        String secondaryType;
        int level;
        int hp;
        int maxHp;
        int attack;
        int defense;
        int exp;
        int expToNextLevel;
        int baseExpYield;
        int catchRate; // Base species catch rate (e.g., Patrat = 255, Joltik = 190)
        List<Move> moves;

        // Non-volatile status condition ("NONE", "BRN", "PAR", "PSN", "SLP", "FRZ")
        String status = "NONE";
        int sleepTurns = 0;

        // Volatile battle conditions (cleared on switch or battle end)
        boolean flinched = false;
        int confusionTurns = 0;

        /**
         * Constructs a new active ZorkmonPet.
         */
        ZorkmonPet(String name, String primaryType, String secondaryType, int level, int hp, int attack, int defense, int baseExpYield, int catchRate, Move initialMove) {
            this.name = name;
            this.primaryType = primaryType;
            this.secondaryType = secondaryType;
            this.level = level;
            this.hp = hp;
            this.maxHp = hp;
            this.attack = attack;
            this.defense = defense;
            this.baseExpYield = baseExpYield;
            this.catchRate = catchRate;
            this.exp = 0;
            this.expToNextLevel = calculateExpForLevel(level + 1);
            this.moves = new ArrayList<>();
            
            // Default baseline Tackle move
            this.moves.add(Move.TACKLE);
            if (initialMove != null && !initialMove.getName().equalsIgnoreCase("Tackle")) {
                this.moves.add(initialMove);
            }
        }

        /**
         * Helper to check if Zorkmon already knows a move by name.
         */
        boolean hasMove(String moveName) {
            for (Move m : moves) {
                if (m.getName().equalsIgnoreCase(moveName)) return true;
            }
            return false;
        }

        /**
         * @return true if the Zorkmon has lost all HP
         */
        boolean isFainted() {
            return this.hp <= 0;
        }

        /**
         * @return true if the Zorkmon has a specific elemental type
         */
        boolean hasType(String type) {
            if (type == null) return false;
            return type.equalsIgnoreCase(primaryType) || (secondaryType != null && type.equalsIgnoreCase(secondaryType));
        }

        /**
         * Formats primary and secondary types for display output.
         */
        String getTypeDisplay() {
            return secondaryType == null ? primaryType : primaryType + "/" + secondaryType;
        }

        /**
         * Formats active non-volatile status tag for UI display (e.g., " [BRN]").
         */
        String getStatusTag() {
            return (status == null || status.equals("NONE")) ? "" : " [" + status + "]";
        }

        /**
         * Clears temporary in-battle conditions like Flinch and Confusion.
         */
        void clearVolatileConditions() {
            this.flinched = false;
            this.confusionTurns = 0;
        }

        /**
         * Completely cures all non-volatile and volatile status conditions.
         */
        void cureStatus() {
            this.status = "NONE";
            this.sleepTurns = 0;
            clearVolatileConditions();
        }

        /**
         * Returns the Gen III/IV/V catch rate multiplier for the Zorkmon's current status.
         */
        double getCatchStatusBonus() {
            if ("SLP".equals(status) || "FRZ".equals(status)) return 2.0;
            if ("PAR".equals(status) || "PSN".equals(status) || "BRN".equals(status)) return 1.5;
            return 1.0;
        }

        /**
         * Calculates total cumulative EXP required to reach a specific level using the cubic curve ($level^3$).
         */
        private static int calculateExpForLevel(int lvl) {
            return lvl * lvl * lvl;
        }

        /**
         * Awards experience points to this Zorkmon and triggers level ups if thresholds are reached.
         */
        public void gainExp(int gainedExp, Scanner scanner) {
            this.exp += gainedExp;
            System.out.println(this.name + " gained " + gainedExp + " EXP! (" + this.exp + "/" + this.expToNextLevel + " EXP)");

            while (this.exp >= this.expToNextLevel) {
                levelUp(scanner);
            }
        }

        /**
         * Advances the Zorkmon by 1 level, boosting stats, fully restoring HP, checking for new moves,
         * and prompting for evolution if eligible.
         */
        private void levelUp(Scanner scanner) {
            this.level++;
            this.expToNextLevel = calculateExpForLevel(this.level + 1);
            this.maxHp += 5;
            this.hp = this.maxHp;
            this.attack += 3;
            this.defense += 2;

            System.out.println("\n------------------------------------------------------------------");
            System.out.println(" LEVEL UP! " + this.name + " grew to Level " + this.level + "!");
            System.out.println(" Max HP: " + (this.maxHp - 5) + " -> " + this.maxHp + " (Fully Healed)");
            System.out.println(" Atk:    " + (this.attack - 3) + " -> " + this.attack);
            System.out.println(" Def:    " + (this.defense - 2) + " -> " + this.defense);
            System.out.println("------------------------------------------------------------------");

            checkAndLearnNewMove(scanner);
            checkAndEvolve(scanner);
        }

        /**
         * Checks if this Zorkmon has reached or passed its evolution level threshold.
         */
        private void checkAndEvolve(Scanner scanner) {
            Evolution evo = Evolution.getForSpecies(this.name);
            if (evo == null || this.level < evo.getMinLevel()) {
                return;
            }
            if (scanner == null) {
                return;
            }

            System.out.println("\n==================================================================");
            System.out.println(" What? " + this.name + " is evolving!");
            System.out.println("==================================================================");

            while (true) {
                System.out.println("Would you like to evolve " + this.name + " into " + evo.getToSpecies() + "?");
                System.out.println("[1] Yes, evolve " + this.name);
                System.out.println("[2] No, stop evolution");
                System.out.print("Select choice > ");

                String choice = scanner.nextLine().trim();
                if (choice.equals("1") || choice.equalsIgnoreCase("yes") || choice.equalsIgnoreCase("y")) {
                    evolve(evo, scanner);
                    break;
                } else if (choice.equals("2") || choice.equalsIgnoreCase("no") || choice.equalsIgnoreCase("n")) {
                    System.out.println("Huh? " + this.name + " stopped evolving!");
                    break;
                } else {
                    System.out.println("Invalid choice! Please enter 1 (Yes) or 2 (No).");
                }
            }
        }

        /**
         * Applies species, type, and stat updates upon evolution, then checks for evolution-level moves.
         */
        private void evolve(Evolution evo, Scanner scanner) {
            String oldName = this.name;
            String oldTypes = getTypeDisplay();
            int oldMaxHp = this.maxHp;
            int oldAttack = this.attack;
            int oldDefense = this.defense;

            this.name = evo.getToSpecies();
            this.primaryType = evo.getNewPrimaryType();
            this.secondaryType = evo.getNewSecondaryType();

            this.maxHp += evo.getHpBonus();
            this.hp = this.maxHp;
            this.attack += evo.getAtkBonus();
            this.defense += evo.getDefBonus();

            System.out.println("\n==================================================================");
            System.out.println(" CONGRATULATIONS! Your " + oldName + " evolved into " + this.name + "!");
            System.out.println(" Type:   " + oldTypes + " -> " + getTypeDisplay());
            System.out.println(" Max HP: " + oldMaxHp + " -> " + this.maxHp);
            System.out.println(" Atk:    " + oldAttack + " -> " + this.attack);
            System.out.println(" Def:    " + oldDefense + " -> " + this.defense);
            System.out.println("==================================================================");

            checkAndLearnNewMove(scanner);
        }

        /**
         * Determines potential move learned at current level based on species and handles the learn/replace choice.
         */
        private void checkAndLearnNewMove(Scanner scanner) {
            Move newMove = getMoveForLevel(this.name, this.level);
            if (newMove == null || hasMove(newMove.getName())) {
                return;
            }

            System.out.println("\n*** " + this.name + " wants to learn " + newMove.getName() + " (" + newMove.getType() + " Type, Power: " + newMove.getPower() + ", Acc: " + newMove.getAccuracy() + "%)! ***");

            if (moves.size() < 4) {
                moves.add(newMove);
                System.out.println(this.name + " learned " + newMove.getName() + "!");
            } else {
                if (scanner == null) {
                    return;
                }
                System.out.println(this.name + " already knows 4 moves:");
                for (int i = 0; i < moves.size(); i++) {
                    Move m = moves.get(i);
                    System.out.println(" [" + (i + 1) + "] " + m.getName() + " (" + m.getType() + " | Power: " + m.getPower() + ")");
                }
                System.out.println("Should " + this.name + " forget a move to learn " + newMove.getName() + "?");
                System.out.println("[1] Yes, replace an existing move");
                System.out.println("[2] No, give up on learning " + newMove.getName());
                System.out.print("Select choice > ");

                String choice = scanner.nextLine().trim();
                if (choice.equals("1") || choice.equalsIgnoreCase("yes")) {
                    System.out.println("\nWhich move should be forgotten?");
                    for (int i = 0; i < moves.size(); i++) {
                        Move m = moves.get(i);
                        System.out.println("[" + (i + 1) + "] " + m.getName() + " (" + m.getType() + ")");
                    }
                    System.out.print("Select move slot to replace (1-4, or 0 to cancel) > ");
                    try {
                        int slot = Integer.parseInt(scanner.nextLine().trim());
                        if (slot >= 1 && slot <= moves.size()) {
                            Move forgotten = moves.set(slot - 1, newMove);
                            System.out.println("1, 2, and... Poof!");
                            System.out.println(this.name + " forgot " + forgotten.getName() + " and learned " + newMove.getName() + "!");
                        } else {
                            System.out.println(this.name + " did not learn " + newMove.getName() + ".");
                        }
                    } catch (NumberFormatException e) {
                        System.out.println(this.name + " did not learn " + newMove.getName() + ".");
                    }
                } else {
                    System.out.println(this.name + " did not learn " + newMove.getName() + ".");
                }
            }
        }

        /**
         * Level-up move lookup table based on species (including evolved forms) and level threshold.
         */
        private static Move getMoveForLevel(String species, int lvl) {
            switch (species) {
                case "Snivy":
                case "Servine":
                case "Serperior":
                    if (lvl == 6) return Move.get("Vine Whip");
                    if (lvl == 8) return Move.get("Mega Drain");
                    if (lvl == 10) return Move.get("Slam");
                    if (lvl == 12) return Move.get("Razor Leaf");
                    if (lvl == 15) return Move.get("Petal Dance");
                    if (lvl == 22) return Move.get("Leech Seed");
                    if (lvl == 36) return Move.get("Solar Beam");
                    break;
                case "Tepig":
                case "Pignite":
                case "Emboar":
                    if (lvl == 6) return Move.get("Ember");
                    if (lvl == 8) return Move.get("Defense Curl");
                    if (lvl == 10) return Move.get("Fire Spin");
                    if (lvl == 12) return Move.get("Take Down");
                    if (lvl == 15) return Move.get("Flamethrower");
                    if (lvl == 17) return Move.get("Karate Chop");
                    if (lvl == 24) return Move.get("Fire Punch");
                    if (lvl == 36) return Move.get("Fire Blast");
                    break;
                case "Oshawott":
                case "Dewott":
                case "Samurott":
                    if (lvl == 6) return Move.get("Water Gun");
                    if (lvl == 8) return Move.get("Focus Energy");
                    if (lvl == 10) return Move.get("Bubble Beam");
                    if (lvl == 12) return Move.get("Surf");
                    if (lvl == 15) return Move.get("Waterfall");
                    if (lvl == 24) return Move.get("Scald");
                    if (lvl == 36) return Move.get("Hydro Pump");
                    break;
                case "Patrat":
                case "Watchog":
                    if (lvl == 5) return Move.get("Bite");
                    if (lvl == 8) return Move.get("Super Fang");
                    if (lvl == 11) return Move.get("Slam");
                    if (lvl == 14) return Move.get("Hyper Fang");
                    break;
                case "Lillipup":
                case "Herdier":
                case "Stoutland":
                    if (lvl == 5) return Move.get("Bite");
                    if (lvl == 8) return Move.get("Take Down");
                    if (lvl == 11) return Move.get("Headbutt");
                    if (lvl == 14) return Move.get("Body Slam");
                    if (lvl == 24) return Move.get("Double-Edge");
                    break;
                case "Pidove":
                case "Tranquill":
                case "Unfezant":
                    if (lvl == 5) return Move.get("Gust");
                    if (lvl == 8) return Move.get("Quick Attack");
                    if (lvl == 11) return Move.get("Wing Attack");
                    if (lvl == 14) return Move.get("Acrobatics");
                    if (lvl == 25) return Move.get("Fly");
                    if (lvl == 32) return Move.get("Hurricane");
                    break;
                case "Sewaddle":
                case "Swadloon":
                case "Leavanny":
                    if (lvl == 5) return Move.get("Bug Bite");
                    if (lvl == 8) return Move.get("Razor Leaf");
                    if (lvl == 11) return Move.get("Pin Missile");
                    if (lvl == 14) return Move.get("Leech Life");
                    if (lvl == 24) return Move.get("Slash");
                    if (lvl == 30) return Move.get("Solar Beam");
                    break;
                case "Venipede":
                case "Whirlipede":
                case "Scolipede":
                    if (lvl == 5) return Move.get("Poison Tail");
                    if (lvl == 8) return Move.get("Bug Bite");
                    if (lvl == 11) return Move.get("Sludge");
                    if (lvl == 14) return Move.get("Take Down");
                    if (lvl == 24) return Move.get("Sludge Wave");
                    if (lvl == 30) return Move.get("Double-Edge");
                    break;
                case "Joltik":
                case "Galvantula":
                    if (lvl == 6) return Move.get("Electroweb");
                    if (lvl == 9) return Move.get("Bug Bite");
                    if (lvl == 12) return Move.get("Thunder Wave");
                    if (lvl == 15) return Move.get("Thunderbolt");
                    if (lvl == 25) return Move.get("Volt Switch");
                    if (lvl == 36) return Move.get("Thunder");
                    break;
                case "Regigigas":
                    if (lvl == 100) return Move.get("Earthquake");
                    break;
            }
            // General filler moves
            if (lvl == 7) return Move.get("Quick Attack");
            if (lvl == 9) return Move.get("Headbutt");
            if (lvl == 13) return Move.get("Body Slam");
            if (lvl == 16) return Move.get("Slash");
            return null;
        }
    }

    // =========================================================================
    // MAIN ENTRY POINT & MAIN MENU
    // =========================================================================

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        boolean inApp = true;

        while (inApp) {
            System.out.println("=========================================");
            System.out.println("      WELCOME TO ZORKMON: UNOVA          ");
            System.out.println("=========================================");
            System.out.println("1. Start Game");
            System.out.println("2. Open Zorkdex");
            System.out.println("3. Exit Program");
            System.out.print("Select an option > ");

            String mainChoice = scanner.nextLine().trim();

            switch (mainChoice) {
                case "1":
                    runGame(scanner, random);
                    break;
                case "2":
                    openZorkdex(scanner);
                    break;
                case "3":
                    System.out.println("Thanks for playing Zorkmon! Goodbye!");
                    inApp = false;
                    break;
                default:
                    System.out.println("Invalid choice! Please enter 1, 2, or 3.\n");
                    break;
            }
        }

        scanner.close();
    }

    // =========================================================================
    // ZORKDEX MENU CONTROLLER
    // =========================================================================

    private static void openZorkdex(Scanner scanner) {
        boolean inZorkdex = true;
        while (inZorkdex) {
            System.out.println("\n--- ZORKDEX ---");
            System.out.println("1. Display All Zorkdex Entries");
            System.out.println("2. Search Zorkdex by Name");
            System.out.println("3. Search Zorkdex by Number");
            System.out.println("4. Filter Zorkdex by Type");
            System.out.println("5. Return to Main Menu");
            System.out.print("Choose an option > ");

            String choice = scanner.nextLine().trim();

            switch (choice) {
                case "1":
                    System.out.println("\n--- All Zorkdex Entries (#000 - #155) ---");
                    for (ZorkdexEntry zorkdexEntry : ZorkdexEntry.getAllEntries()) {
                        System.out.println(zorkdexEntry);
                    }
                    break;
                case "2":
                    System.out.print("Enter name to search in Zorkdex: ");
                    String zorkdexSearchName = scanner.nextLine().trim();
                    List<ZorkdexEntry> zorkdexNameMatches = ZorkdexEntry.getAllEntries().stream()
                            .filter(p -> p.getName().equalsIgnoreCase(zorkdexSearchName))
                            .collect(Collectors.toList());
                    if (zorkdexNameMatches.isEmpty()) {
                        System.out.println("No Zorkdex entry found matching: " + zorkdexSearchName);
                    } else {
                        zorkdexNameMatches.forEach(System.out::println);
                    }
                    break;
                case "3":
                    System.out.print("Enter Zorkdex number (000-155): ");
                    try {
                        int zorkdexNum = Integer.parseInt(scanner.nextLine().trim());
                        ZorkdexEntry.getAllEntries().stream()
                                .filter(p -> p.getId() == zorkdexNum)
                                .findFirst()
                                .ifPresentOrElse(
                                        System.out::println,
                                        () -> System.out.println("No Zorkdex entry with #" + String.format("%03d", zorkdexNum))
                                );
                    } catch (NumberFormatException e) {
                        System.out.println("Invalid number format!");
                    }
                    break;
                case "4":
                    System.out.print("Enter type (e.g. Fire, Dragon, Bug): ");
                    String zorkdexType = scanner.nextLine().trim();
                    List<ZorkdexEntry> zorkdexTypeMatches = ZorkdexEntry.getAllEntries().stream()
                            .filter(p -> p.getPrimaryType().equalsIgnoreCase(zorkdexType) ||
                                         (p.getSecondaryType() != null && p.getSecondaryType().equalsIgnoreCase(zorkdexType)))
                            .collect(Collectors.toList());
                    if (zorkdexTypeMatches.isEmpty()) {
                        System.out.println("No Zorkdex entries found with type: " + zorkdexType);
                    } else {
                        System.out.printf("\n--- %s Type Zorkdex Entries (%d found) ---\n", zorkdexType, zorkdexTypeMatches.size());
                        zorkdexTypeMatches.forEach(System.out::println);
                    }
                    break;
                case "5":
                    inZorkdex = false;
                    System.out.println("Closing Zorkdex...\n");
                    break;
                default:
                    System.out.println("Invalid choice! Please pick 1-5.");
                    break;
            }
        }
    }

