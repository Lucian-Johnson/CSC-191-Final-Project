    /**
     * Interactive PC terminal interface for depositing, withdrawing, and swapping boxed Zorkmon.
     */
    private static void handleStoragePC(List<ZorkmonPet> party, List<ZorkmonPet> storageBox, Scanner scanner) {
        boolean inStorage = true;
        while (inStorage) {
            System.out.println("\n--- ZORKMON STORAGE SYSTEM ---");
            System.out.println("Party: " + party.size() + "/6 | Storage Box: " + storageBox.size() + " Zorkmon");
            System.out.println("[1] Deposit Zorkmon to Storage");
            System.out.println("[2] Withdraw Zorkmon from Storage");
            System.out.println("[3] Swap Party Zorkmon with Stored Zorkmon");
            System.out.println("[4] View Stored Zorkmon");
            System.out.println("[5] Exit PC");
            System.out.print("Select PC option > ");

            String choice = scanner.nextLine().trim();
            switch (choice) {
                case "1": // DEPOSIT
                    if (party.size() <= 1) {
                        System.out.println("You cannot deposit your last active Zorkmon!");
                        break;
                    }
                    System.out.println("\n--- SELECT ZORKMON TO DEPOSIT ---");
                    for (int i = 0; i < party.size(); i++) {
                        ZorkmonPet p = party.get(i);
                        System.out.println("[" + (i + 1) + "] " + p.name + " (Lvl " + p.level + " " + p.getTypeDisplay() + " | HP: " + p.hp + "/" + p.maxHp + ")");
                    }
                    System.out.print("Select party slot to deposit (0 to cancel) > ");
                    try {
                        int slot = Integer.parseInt(scanner.nextLine().trim());
                        if (slot >= 1 && slot <= party.size()) {
                            ZorkmonPet deposited = party.remove(slot - 1);
                            storageBox.add(deposited);
                            System.out.println(deposited.name + " was moved to PC Storage!");
                        }
                    } catch (NumberFormatException ignored) {}
                    break;

                case "2": // WITHDRAW
                    if (party.size() >= 6) {
                        System.out.println("Your party is full (6/6)! Deposit a Zorkmon or swap instead.");
                        break;
                    }
                    if (storageBox.isEmpty()) {
                        System.out.println("Your storage box is empty!");
                        break;
                    }
                    System.out.println("\n--- SELECT ZORKMON TO WITHDRAW ---");
                    for (int i = 0; i < storageBox.size(); i++) {
                        ZorkmonPet p = storageBox.get(i);
                        System.out.println("[" + (i + 1) + "] " + p.name + " (Lvl " + p.level + " " + p.getTypeDisplay() + " | HP: " + p.hp + "/" + p.maxHp + ")");
                    }
                    System.out.print("Select stored Zorkmon to withdraw (0 to cancel) > ");
                    try {
                        int slot = Integer.parseInt(scanner.nextLine().trim());
                        if (slot >= 1 && slot <= storageBox.size()) {
                            ZorkmonPet withdrawn = storageBox.remove(slot - 1);
                            party.add(withdrawn);
                            System.out.println(withdrawn.name + " was added to your party!");
                        }
                    } catch (NumberFormatException ignored) {}
                    break;

                case "3": // SWAP
                    if (storageBox.isEmpty()) {
                        System.out.println("Your storage box is empty!");
                        break;
                    }
                    System.out.println("\n--- SELECT PARTY ZORKMON TO SWAP OUT ---");
                    for (int i = 0; i < party.size(); i++) {
                        ZorkmonPet p = party.get(i);
                        System.out.println("[" + (i + 1) + "] " + p.name + " (Lvl " + p.level + " " + p.getTypeDisplay() + " | HP: " + p.hp + "/" + p.maxHp + ")");
                    }
                    System.out.print("Select party slot (0 to cancel) > ");
                    try {
                        int pSlot = Integer.parseInt(scanner.nextLine().trim());
                        if (pSlot >= 1 && pSlot <= party.size()) {
                            System.out.println("\n--- SELECT STORED ZORKMON TO SWAP IN ---");
                            for (int i = 0; i < storageBox.size(); i++) {
                                ZorkmonPet p = storageBox.get(i);
                                System.out.println("[" + (i + 1) + "] " + p.name + " (Lvl " + p.level + " " + p.getTypeDisplay() + " | HP: " + p.hp + "/" + p.maxHp + ")");
                            }
                            System.out.print("Select stored Zorkmon slot (0 to cancel) > ");
                            int sSlot = Integer.parseInt(scanner.nextLine().trim());
                            if (sSlot >= 1 && sSlot <= storageBox.size()) {
                                ZorkmonPet partyPet = party.get(pSlot - 1);
                                ZorkmonPet storedPet = storageBox.get(sSlot - 1);

                                party.set(pSlot - 1, storedPet);
                                storageBox.set(sSlot - 1, partyPet);
                                System.out.println("Swapped " + partyPet.name + " with " + storedPet.name + "!");
                            }
                        }
                    } catch (NumberFormatException ignored) {}
                    break;

                case "4": // VIEW
                    if (storageBox.isEmpty()) {
                        System.out.println("Storage box is empty.");
                    } else {
                        System.out.println("\n--- CURRENTLY STORED ZORKMON ---");
                        for (int i = 0; i < storageBox.size(); i++) {
                            ZorkmonPet p = storageBox.get(i);
                            System.out.println("[" + (i + 1) + "] " + p.name + " - Lvl " + p.level + " " + p.getTypeDisplay() + " | HP: " + p.hp + "/" + p.maxHp);
                        }
                    }
                    break;

                case "5": // EXIT
                    inStorage = false;
                    break;

                default:
                    System.out.println("Invalid PC option!");
                    break;
            }
        }
    }

