    /**
     * Handles switching the active leading Zorkmon while exploring the overworld.
     */
    private static int handleFieldSwitch(List<ZorkmonPet> party, int currentActiveIndex, Scanner scanner) {
        if (party.size() <= 1) {
            System.out.println("You only have 1 Zorkmon in your team! Catch more wild Zorkmon to switch.");
            return currentActiveIndex;
        }

        System.out.println("\n--- SELECT ZORKMON TO SWITCH TO ---");
        for (int i = 0; i < party.size(); i++) {
            ZorkmonPet pet = party.get(i);
            String statusStr = (i == currentActiveIndex) ? " [CURRENT ACTIVE]" : "";
            if (pet.isFainted()) statusStr += " (FAINTED)";
            System.out.println("[" + (i + 1) + "] " + pet.name + " (Lvl " + pet.level + " " + pet.getTypeDisplay() + " | HP: " + pet.hp + "/" + pet.maxHp + ")" + statusStr);
        }
        System.out.print("Select Zorkmon number (or 0 to cancel) > ");
        try {
            int sel = Integer.parseInt(scanner.nextLine().trim());
            if (sel > 0 && sel <= party.size()) {
                int targetIdx = sel - 1;
                if (targetIdx == currentActiveIndex) {
                    System.out.println(party.get(targetIdx).name + " is already active!");
                } else if (party.get(targetIdx).isFainted()) {
                    System.out.println(party.get(targetIdx).name + " is fainted and cannot battle!");
                } else {
                    System.out.println("Switched leading Zorkmon to " + party.get(targetIdx).name + "!");
                    return targetIdx;
                }
            }
        } catch (NumberFormatException e) {
            System.out.println("Invalid selection!");
        }
        return currentActiveIndex;
    }

