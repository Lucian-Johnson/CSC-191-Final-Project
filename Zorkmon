    /**
     * Handles wild Zorkmon battle encounters with accuracy checks, secondary status/flinch effects,
     * and end-of-turn status damage.
     */
    private static boolean startSingleBattle(List<ZorkmonPet> party, List<ZorkmonPet> storageBox, int initialActiveIndex, ZorkmonPet opponent, Scanner scanner, Random random, int[] zorkBalls, int[] money) {
        System.out.println("================ BATTLE START ================");
        System.out.println("Battle against wild " + opponent.name + " (" + opponent.getTypeDisplay() + " Type)!");

        int activeIdx = initialActiveIndex;
        party.get(activeIdx).clearVolatileConditions();
        opponent.clearVolatileConditions();

        while (!allFainted(party) && !opponent.isFainted()) {
            ZorkmonPet player = party.get(activeIdx);

            if (player.isFainted()) {
                System.out.println("\n" + player.name + " is fainted! You must send out another Zorkmon!");
                activeIdx = forceBattleSwitch(party, activeIdx, scanner);
                player = party.get(activeIdx);
            }

            // Reset single-turn Flinch flags at the start of every turn
            player.flinched = false;
            opponent.flinched = false;

            System.out.println("\n" + player.name + player.getStatusTag() + " HP: " + player.hp + "/" + player.maxHp
                    + " | " + opponent.name + opponent.getStatusTag() + " HP: " + opponent.hp + "/" + opponent.maxHp);
            System.out.println("Actions: [1] Fight  [2] Catch  [3] Switch  [4] Run");
            System.out.print("Battle > ");

            String mainChoice = scanner.nextLine().trim();

            if (mainChoice.equals("4") || mainChoice.equalsIgnoreCase("run")) {
                player.clearVolatileConditions();
                System.out.println("You fled back to safety!");
                return false;
            }

            Move selectedMove = null;

            if (mainChoice.equals("1") || mainChoice.equalsIgnoreCase("fight")) {
                System.out.println("\n--- CHOOSE A MOVE ---");
                for (int i = 0; i < player.moves.size(); i++) {
                    Move m = player.moves.get(i);
                    String effectTag = (m.getEffect() != null) ? " [" + m.getEffect() + " " + m.getEffectChance() + "%]" : "";
                    System.out.println("[" + (i + 1) + "] " + m.getName() + " (" + m.getType() + " | Power: " + m.getPower() + " | Acc: " + m.getAccuracy() + "%)" + effectTag);
                }
                System.out.print("Select move (0 to go back) > ");
                try {
                    int mChoice = Integer.parseInt(scanner.nextLine().trim());
                    if (mChoice >= 1 && mChoice <= player.moves.size()) {
                        selectedMove = player.moves.get(mChoice - 1);
                    } else {
                        continue;
                    }
                } catch (NumberFormatException e) {
                    System.out.println("Invalid selection!");
                    continue;
                }
            } else if (mainChoice.equals("2") || mainChoice.equalsIgnoreCase("catch")) {
                if (zorkBalls[0] <= 0) {
                    System.out.println("\nYou don't have any Zork Balls left!");
                    continue;
                } else {
                    zorkBalls[0]--;
                    System.out.println("\nYou threw a Zork Ball! (Remaining Zork Balls: " + zorkBalls[0] + ")");
                    boolean caught = attemptCatch(opponent, 1.0, opponent.getCatchStatusBonus(), random);
                    if (caught) {
                        opponent.clearVolatileConditions();
                        player.clearVolatileConditions();
                        System.out.println("Gotcha! " + opponent.name + " was caught!");

                        if (party.size() < 6) {
                            party.add(opponent);
                            System.out.println(opponent.name + " was added to your party!");
                        } else {
                            System.out.println("\nYour party is full (6/6 Zorkmon)!");
                            boolean replaced = promptPartyReplacement(party, opponent, scanner);
                            if (!replaced) {
                                storageBox.add(opponent);
                                System.out.println(opponent.name + " was sent to PC storage!");
                            }
                        }

                        int expGained = (opponent.baseExpYield * opponent.level) / 7;
                        int prizeMoney = opponent.level * 40;
                        money[0] += prizeMoney;
                        System.out.println("\n" + player.name + " earned EXP for catching " + opponent.name + "!");
                        System.out.println("You collected $" + prizeMoney + " after the battle!");
                        player.gainExp(expGained, scanner);
                        return true;
                    } else {
                        System.out.println("Oh no! The Zorkmon broke free!");
                    }
                }
            } else if (mainChoice.equals("3") || mainChoice.equalsIgnoreCase("switch")) {
                int newIdx = handleInBattleSwitch(party, activeIdx, scanner);
                if (newIdx != activeIdx) {
                    player.clearVolatileConditions();
                    activeIdx = newIdx;
                    player = party.get(activeIdx);
                    player.clearVolatileConditions();
                    System.out.println("Go! " + player.name + "!");
                } else {
                    continue;
                }
            } else {
                System.out.println("Invalid battle choice!");
                continue;
            }

            // --- Player Attack Turn ---
            if (selectedMove != null) {
                executeMoveTurn(player, opponent, selectedMove, false, random, "");

                if (opponent.isFainted()) {
                    player.clearVolatileConditions();
                    System.out.println("\n" + opponent.name + " fainted! You won the battle!");

                    int expGained = (opponent.baseExpYield * opponent.level) / 7;
                    int prizeMoney = opponent.level * 50;
                    money[0] += prizeMoney;
                    System.out.println("You won $" + prizeMoney + " in prize money!");
                    player.gainExp(expGained, scanner);
                    return true;
                }
            }

            // --- Opponent Counterattack Turn ---
            if (!player.isFainted() && !opponent.isFainted()) {
                System.out.println("\n" + opponent.name + " prepares to attack!");
                Move oppMove = opponent.moves.get(random.nextInt(opponent.moves.size()));
                executeMoveTurn(opponent, player, oppMove, true, random, "");
            }

            // --- End-of-Turn Status Damage (Burn / Poison) ---
            if (!player.isFainted()) {
                applyEndOfTurnStatusDamage(player);
            }
            if (!opponent.isFainted()) {
                applyEndOfTurnStatusDamage(opponent);
                if (opponent.isFainted()) {
                    player.clearVolatileConditions();
                    System.out.println("\n" + opponent.name + " fainted! You won the battle!");

                    int expGained = (opponent.baseExpYield * opponent.level) / 7;
                    int prizeMoney = opponent.level * 50;
                    money[0] += prizeMoney;
                    System.out.println("You won $" + prizeMoney + " in prize money!");
                    player.gainExp(expGained, scanner);
                    return true;
                }
            }
        }

        party.get(activeIdx).clearVolatileConditions();
        return false;
    }

