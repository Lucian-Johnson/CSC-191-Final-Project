package zorkmon;

import java.awt.*;
import java.awt.event.*;
import javax.swing.*;

public class GUI extends JFrame {

    // Main Components
    private final JTextArea gameLog;
    private final JButton startButton;
    private final JButton dexButton;
    private final JButton exitButton;

    private final JLabel titleLabel;
    private final JPanel topPanel;
    private final JPanel buttonPanel;
    private final JScrollPane scrollPane;

    public GUI() {

        //----------------------------------
        // Window Setup
        //----------------------------------

        setTitle("Zorkmon!");
        setSize(900, 650);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout());

        //----------------------------------
        // Title Panel
        //----------------------------------

        topPanel = new JPanel();

        topPanel.setBackground(new Color(66, 135, 245));

        titleLabel = new JLabel("ZORKMON!");

        titleLabel.setFont(new Font("Comic Sans MS",
                Font.BOLD, 28));

        titleLabel.setForeground(Color.WHITE);

        topPanel.add(titleLabel);

        //----------------------------------
        // Game Output Area
        //----------------------------------

        gameLog = new JTextArea();

        gameLog.setEditable(false);

        gameLog.setFont(new Font("Monospaced",
                Font.PLAIN, 15));

        gameLog.setBackground(new Color(250,250,250));

        gameLog.setText(
                "Welcome to Zorkmon!\n\n" +
                "Professor Juniper is waiting for you...\n");

        scrollPane = new JScrollPane(gameLog);

        //----------------------------------
        // Bottom Buttons
        //----------------------------------

        buttonPanel = new JPanel();

        startButton = new JButton("🎮 New Adventure");

        dexButton = new JButton("📖 Open Zorkdex");

        exitButton = new JButton("❌ Exit");

        startButton.setBackground(new Color(100,220,100));

        dexButton.setBackground(new Color(255,220,100));

        exitButton.setBackground(new Color(255,120,120));

        buttonPanel.add(startButton);
        buttonPanel.add(dexButton);
        buttonPanel.add(exitButton);

        //----------------------------------
        // Add Panels
        //----------------------------------

        add(topPanel, BorderLayout.NORTH);
        add(scrollPane, BorderLayout.CENTER);
        add(buttonPanel, BorderLayout.SOUTH);

        //----------------------------------
        // Button Actions
        //----------------------------------

        startButton.addActionListener(e -> startGame());

        dexButton.addActionListener(e -> openDex());

        exitButton.addActionListener(e -> System.exit(0));
    }

    //-------------------------------------------------------
    // GAME START
    //-------------------------------------------------------

    private void startGame() {

        String trainerName = JOptionPane.showInputDialog(
                this,
                "What is your trainer name?"
        );

        if (trainerName == null || trainerName.isBlank()) {
            trainerName = "Hero";
        }

        gameLog.append("\n");
        gameLog.append("Professor Juniper: Welcome "
                + trainerName + "!\n");
        gameLog.append("Your Zorkmon journey begins!\n");
    }

    //-------------------------------------------------------
    // OPEN ZORKDEX
    //-------------------------------------------------------

    private void openDex() {

        JFrame dexFrame = new JFrame("Zorkdex");

        dexFrame.setSize(500,600);

        JTextArea dexArea = new JTextArea();

        dexArea.setEditable(false);

        StringBuilder builder = new StringBuilder();

        for(ZorkdexData.ZorkdexEntry entry :
                ZorkdexData.ZorkdexEntry.getAllEntries()) {

            builder.append(entry.toString())
                    .append("\n");
        }

        dexArea.setText(builder.toString());

        dexFrame.add(new JScrollPane(dexArea));

        dexFrame.setLocationRelativeTo(this);

        dexFrame.setVisible(true);
    }

    //-------------------------------------------------------
    // Main Method
    //-------------------------------------------------------

    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {

            new GUI().setVisible(true);

        });

    }
}
